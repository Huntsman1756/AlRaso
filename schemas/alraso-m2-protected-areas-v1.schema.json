{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alraso-m2-protected-areas/v1",
  "title": "AlRaso M2 Protected Areas",
  "description": "Schema for AlRaso protected-area GeoJSON features — OSM boundary=protected_area relations as visual reference only.",
  "type": "object",
  "required": ["$schema", "metadata", "features"],
  "properties": {
    "$schema": {
      "const": "alraso-m2-protected-areas/v1"
    },
    "metadata": {
      "type": "object",
      "required": [
        "schema",
        "snapshot",
        "may_be_stale",
        "source",
        "source_digests",
        "license",
        "attribution"
      ],
      "properties": {
        "schema": { "type": "string" },
        "snapshot": { "type": "boolean" },
        "may_be_stale": { "type": "boolean" },
        "retrieved_at": { "type": "string" },
        "source": { "type": "string" },
        "source_url": { "type": "string", "format": "uri" },
        "overpass_endpoint": { "type": "string", "format": "uri" },
        "query_ordesa": { "type": "string" },
        "query_picos": { "type": "string" },
        "source_digests": {
          "type": "object",
          "required": [
            "ordesa_overpass_response_sha256",
            "picos_overpass_response_sha256"
          ],
          "properties": {
            "ordesa_overpass_response_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "picos_overpass_response_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        },
        "license": { "const": "ODbL-1.0" },
        "license_url": { "type": "string", "format": "uri" },
        "attribution": { "type": "string" },
        "note": { "type": "string" },
        "simplification": {
          "type": "object",
          "properties": {
            "method": { "type": "string" },
            "tolerance_degrees": { "type": "number" },
            "per_feature": {
              "type": "object",
              "patternProperties": {
                "^pa-(ordesa|picos)$": {
                  "type": "object",
                  "required": [
                    "tolerance",
                    "vertices_before",
                    "vertices_after",
                    "vertices_reduced"
                  ],
                  "properties": {
                    "tolerance": { "type": "number" },
                    "vertices_before": { "type": "integer" },
                    "vertices_after": { "type": "integer" },
                    "vertices_reduced": { "type": "integer" }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "official_crosscheck": {
          "type": "object",
          "properties": {
            "source": { "type": "string" },
            "source_url": { "type": "string", "format": "uri" },
            "retrieved_at": { "type": "string" },
            "parks": {
              "type": "object",
              "properties": {
                "ordesa": {
                  "type": "object",
                  "properties": {
                    "osm_relation_id": { "type": "string" },
                    "osm_area_ha": { "type": "number" },
                    "official_area_ha": { "type": "number" },
                    "delta_pct": { "type": "number" },
                    "official_response_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "official_source_url": { "type": "string", "format": "uri" },
                    "official_redistribution": { "type": "string" }
                  }
                },
                "picos": {
                  "type": "object",
                  "properties": {
                    "osm_relation_id": { "type": "string" },
                    "osm_area_ha": { "type": "number" },
                    "official_area_ha": { "type": "number" },
                    "delta_pct": { "type": "number" },
                    "official_response_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "official_source_url": { "type": "string", "format": "uri" },
                    "official_redistribution": { "type": "string" }
                  }
                }
              }
            },
            "guard_threshold_pct": { "type": "number" },
            "guard_passed": { "type": "boolean" }
          }
        },
        "builder_self_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fixture_digests": {
          "type": "object",
          "properties": {
            "ordesa_fixture_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "picos_fixture_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "attribution": { "type": "string" },
    "policy": { "type": "string" },
    "features": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "category",
          "name",
          "geometry",
          "properties"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^pa-(ordesa|picos)$"
          },
          "type": { "const": "Feature" },
          "category": { "const": "protected_area" },
          "name": { "type": "string" },
          "geometry": {
            "oneOf": [
              {
                "type": "object",
                "required": ["type", "coordinates"],
                "properties": {
                  "type": { "const": "Polygon" },
                  "coordinates": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": { "type": "number" }
                      }
                    }
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["type", "coordinates"],
                "properties": {
                  "type": { "const": "MultiPolygon" },
                  "coordinates": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "array",
                          "items": { "type": "number" }
                        }
                      }
                    }
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "properties": {
            "type": "object",
            "required": [
              "id",
              "name",
              "category",
              "region",
              "source",
              "source_label",
              "source_ref",
              "source_license",
              "snapshot_date",
              "attribution",
              "osm_url",
              "note"
            ],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "category": { "const": "protected_area" },
              "region": { "type": "string", "enum": ["ordesa", "picos"] },
              "source": { "const": "openstreetmap" },
              "source_label": { "const": "OSM" },
              "source_ref": {
                "type": "string",
                "pattern": "^relation/(10036292|2401595)$"
              },
              "source_license": { "const": "ODbL-1.0" },
              "snapshot_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "attribution": { "type": "string" },
              "osm_url": { "type": "string", "format": "uri" },
              "note": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}