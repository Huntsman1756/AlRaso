	var extractRules = function(boletines, anyo, mes) {
		var keys = Object.keys(boletines);
		var boletinrule = {};
		boletinrule[anyo] = {};
		boletinrule[anyo][mes] = {};
		var days = jQuery.map( keys, function(key){
