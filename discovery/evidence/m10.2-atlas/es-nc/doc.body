		}).join(',');
		boletinrule[anyo][mes][days] = 'boletin-' + anyo + '-' + mes;

		return boletinrule;
	}

	var boletines = {"2023-11-30":[{"boletinId":"2023.249","extraordinario":null,"numero":249}],"2023-11-29":[{"boletinId":"2023.248","extraordinario":null,"numero":248}],"2023-11-28":[{"boletinId":"2023.247","extraordinario":null,"numero":247}],"2023-11-27":[{"boletinId":"2023.246","extraordinario":null,"numero":246}],"2023-11-24":[{"boletinId":"2023.245","extraordinario":null,"numero":245}],"2023-11-23":[{"boletinId":"2023.244","extraordinario":"EXTRAORDINARIO","numero":244},{"boletinId":"2023.243","extraordinario":null,"numero":243}],"2023-11-22":[{"boletinId":"2023.242","extraordinario":null,"numero":242}],"2023-11-21":[{"boletinId":"2023.241","extraordinario":null,"numero":241}],"2023-11-20":[{"boletinId":"2023.240","extraordinario":null,"numero":240}],"2023-11-17":[{"boletinId":"2023.239","extraordinario":null,"numero":239}],"2023-11-16":[{"boletinId":"2023.238","extraordinario":null,"numero":238}],"2023-11-15":[{"boletinId":"2023.237","extraordinario":null,"numero":237}],"2023-11-14":[{"boletinId":"2023.236","extraordinario":null,"numero":236}],"2023-11-13":[{"boletinId":"2023.235","extraordinario":null,"numero":235}],"2023-11-10":[{"boletinId":"2023.234","extraordinario":null,"numero":234}],"2023-11-09":[{"boletinId":"2023.233","extraordinario":null,"numero":233}],"2023-11-08":[{"boletinId":"2023.232","extraordinario":null,"numero":232}],"2023-11-07":[{"boletinId":"2023.231","extraordinario":null,"numero":231}],"2023-11-06":[{"boletinId":"2023.230","extraordinario":null,"numero":230}],"2023-11-03":[{"boletinId":"2023.229","extraordinario":null,"numero":229}],"2023-11-02":[{"boletinId":"2023.228","extraordinario":null,"numero":228}]};
	var defaultYear = 2023;
	var defaultMonth = 10;
	var defaultEnabledRulename = 'boletin-' + defaultYear + '-' + defaultMonth;
	var boletinrulenames = [defaultEnabledRulename];
	var boletinrules = extractRules(boletines, defaultYear, defaultMonth);
	var fecha = new Date('2023-11-23');


	// realiza llamada ajax para recuperar los boletines de un mes y refresca el calendario
	var getBoletines = function (anyo, mes) {
		var rulename = 'boletin-' + anyo + '-' + mes;

		if (boletinrulenames.indexOf(rulename) == -1) {
			A.io.request('https://bon.navarra.es/es/anuncio?p_p_id=es_navarra_bon_calendario_portlet_CalendarioPortlet_INSTANCE_6JrV16g0duGz&p_p_lifecycle=2&p_p_state=normal&p_p_mode=view&p_p_resource_id=getBoletines&p_p_cacheability=cacheLevelPage', {
				dataType: 'json',
				data : {
					_es_navarra_bon_calendario_portlet_CalendarioPortlet_INSTANCE_6JrV16g0duGz_anyo : anyo,
					_es_navarra_bon_calendario_portlet_CalendarioPortlet_INSTANCE_6JrV16g0duGz_mes : mes,
				},
				on : {
					success : function() {
						var responseData = this.get('responseData');
						$.extend(true, boletines, responseData);
						$.extend(true, boletinrules, extractRules(responseData, anyo, mes));

						calendar.set('enabledDatesRule', rulename);
						calendar.render();

						boletinrulenames.push(rulename);
					}
				}
			});
		} else {
			calendar.set('enabledDatesRule', rulename);
		}
	}



	var filterFunction = function (date, node, rules) {
		var i;
		for (i = 0; i < rules.length; i++) {
			if (rules[i].indexOf('boletin') == 0) {
//				node.addClass("redtext");
//				node.setAttribute('data-num-boletin', 'https://www.google.com');
				var title = jQuery.map( boletines[date.toISOString().substring(0, 10)], function(boletin){
					if(themeDisplay.getLanguageId()=='eu_ES'){
						return  boletin.numero +'\u0042\u004f\u004c\u0045\u0054\u00cd\u004e\u0020\u004e\u00ba\u0020 ' + ' - ' + date.getFullYear();
					}else{
						return '\u0042\u004f\u004c\u0045\u0054\u00cd\u004e\u0020\u004e\u00ba\u0020 ' + boletin.numero + ' - ' + date.getFullYear();
					}
				}).join(',');
				node.set('title', title);
				var bolentinExtraordinario = jQuery.map(boletines[date.toISOString().substring(0, 10)], function(boletin){
					return boletin.extraordinario;
				}).join(',');
				if(bolentinExtraordinario!=''){
					node.addClass("cal_boletin_extraordinario");
				}
			}
		}
	};
	
	window.calendar = new A.Calendar({
		contentBox: "#_es_navarra_bon_calendario_portlet_CalendarioPortlet_INSTANCE_6JrV16g0duGz_calendario-wrapper",
		dateFormat: '%d/%m/%Y',
		showPrevMonth: true,
		showNextMonth: true,
		minimumDate: new Date('1996-05-01'),
		maximumDate: new Date('2026-09-17'),
		date: fecha,
		enabledDatesRule: defaultEnabledRulename,
		on: {
			dateClick: function(event) {
//				window.mievento = event;
//				var anyo = event.newVal.getFullYear();
//				var numBoletin = window.mievento.cell.getAttribute('data-num-boletin');
				var numBoletines = jQuery.map( boletines[event.date.toISOString().substring(0, 10)], function(boletin){
					return boletin.numero;
				}).join('_');

				location.href = 'https://bon.navarra.es/es/boletin/-/sumario/0/0'.replace(new RegExp('/0/0$'), '/' + event.date.getFullYear() + '/' + numBoletines);
			},
			dateChange: function(event) {
				getBoletines(event.newVal.getFullYear(), event.newVal.getMonth());
			}
		}
	});

	calendar.set('customRenderer', {
	   	rules : boletinrules,
		filterFunction: filterFunction
	});

	
		calendar.selectDates(fecha);
	


	calendar.render();
})();});
