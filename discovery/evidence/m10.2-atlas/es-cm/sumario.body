			    var cambioMes = 'no';
				function init(){
		
					if($('calendario')){
					
						var browserName = navigator.appName; 
						
						if (browserName=="Microsoft Internet Explorer") {
							$('calendario').style.display = "block";
						}
						else {
							$('calendario').style.display = "table";
						}
					}
					
					if($('buscaFecha')){
						$('buscaFecha').hide();
					}
					
					$("botonImprimir").style.visibility = "visible";
					
					//Si se ha cambiado el mes desde el combo de meses, se le pone el foco a este para que
					//pueda seguir seleccionando meses con las flechas del cursor
					if (cambioMes == 'si'){
						document.getElementById('mes').focus();
					}
					
				}
		
				function resizeMenu(){
					
					if (navigator.appName.indexOf("Explorer") != -1) {	
					
						var alturaMenu = $("menu").clientHeight;
						$("tablaMenu").style.height = alturaMenu - $("menu").offsetTop - $("filaCalendario").clientHeight;
					}
				}
				
				function tunearLinks() {
	    			var links = document.getElementsByTagName('a');
	    			
	    			for (var i=0;i < links.length;i++) {
	        			if (links[i].className.indexOf('new-window') != -1) {
	            			links[i].onclick = function() {
	                			window.open(this.href);
	                			return false;
	            			};
	            			
	            			links[i].onkeypress = function() {
	                			window.open(this.href);
	                			return false;
	            			};
	        			}
	    			}
	    			
	    			links = document.getElementsByTagName('form');
	    			
	    			for (var i=0;i < links.length;i++) {
	        			if (links[i].className == 'new-window') {
	            			
	            			links[i].target = "_blank";
	            		}
	    			}
				};
				
				function limpiar() {
					if($F("textoBusqueda") == "Buscar...") {
						$("textoBusqueda").setValue("");
					}				
				}
				
		</script>
		
