<script type="text/javascript">

var json = {    "cookieTypes":[       {          "type":"Necesarias",          "value":"necessary",          "required":true,          "description":"Las cookies necesarias ayudan a hacer una página web utilizable activando funciones básicas como la navegación en la página y el acceso a áreas seguras de la página web. La página web no puede funcionar adecuadamente sin estas cookies.",          "lista":[             {                "name":"COOKIE_SUPPORT",                "description":"Esta cookie determina si el navegador acepta cookies.",                "tipo":"HTTP",                "required":true,                "proveedor":"miprincipado.asturias.es"             },             {                "name":"JSESSIONID",                "description":"Conserva los estados de los usuarios en todas las peticiones de la página.",                "tipo":"HTTP",                "required":true,                "proveedor":"miprincipado.asturias.es"             },             {                "name":"LFR_SESSION_STATE_*",                "description":"Cookie utilizada por el portal web para el control de tiempo de sesión.",                "tipo":"HTTP",                "required":true,                "proveedor":"miprincipado.asturias.es"             }          ]       },       {          "type":"Preferencias",          "value":"preferences",          "description":"Las cookies de preferencias permiten a la página web recordar información que cambia la forma en que la página se comporta o el aspecto que tiene, como su idioma preferido o la región en la que usted se encuentra.",          "required":false,          "lista":[             {                "name":"GUEST_LANGUAGE_ID",                "description":"Determina el idioma preferido por el visitante. Permite a la web establecer el idioma preferido en el reingreso del visitante.",                "tipo":"HTTP",                "required":false,                "proveedor":"miprincipado.asturias.es"             }          ]       },       {          "type":"Estadística",          "value":"statistics",          "description":"Las cookies estadísticas ayudan a los propietarios de páginas web a comprender cómo interactúan los visitantes con las páginas web reuniendo y proporcionando información de forma anónima.",          "required":false,          "lista":[             {                "name":"_ga",                "description":"Registra una identificación única que se utiliza para generar datos estadísticos acerca de cómo utiliza el visitante el sitio web.",                "tipo":"HTTP",                "required":false,                "proveedor":"miprincipado.asturias.es"             },             {                "name":"_gat",                "description":"Utilizado por Google Analytics para controlar la tasa de peticiones",                "tipo":"HTTP",                "required":false,                "proveedor":"miprincipado.asturias.es"             },             {                "name":"_gid",                "description":"Registra una identificación única que se utiliza para generar datos estadísticos acerca de cómo utiliza el visitante el sitio web .",                "tipo":"HTTP",                "required":false,                "proveedor":"miprincipado.asturias.es"             }          ]       }    ],    "title":"Acepta las cookies y La política de cookies",    "message":"Las cookies de este sitio web se usan para personalizar el contenido y los anuncios, ofrecer funciones de redes sociales y analizar el tráfico. Además, compartimos información sobre el uso que haga del sitio web con nuestros partners de redes sociales, publicidad y análisis web, quienes pueden combinarla con otra información que les haya proporcionado o que hayan recopilado a partir del uso que haya hecho de sus servicios.",    "message-confirm-1":"Has aceptado/personalizado las cookies para miprincipado.asturias.es. Puedes cambiar la ",    "message-confirm-2":" en cualquier momento ",    "message-confirm-link":" configuración de las cookies ",    "delay":600,    "expires":30,    "link":"/cookies",    "uncheckBoxes":true,    "acceptBtnLabel":"Aceptar Cookies",    "acceptBtnLabelAll":"Aceptar Todas",    "rejectAll":"Rechazar todas",    "advancedBtnLabel":"Personalizar Cookies",    "hideBtnLabel":"Entendido, ocultar mensaje",    "moreInfoLabel":"Más Información",    "cookieTypesTitle":"Seleccione las cookies que desea aceptar",    "fixedCookieTypeLabel":"Esenciales",    "fixedCookieTypeDesc":"Estas cookies son esenciales para el funcionamiento de la plataforma.",    "sronly":"cookies" };

</script>

<script id="handlebars-cookie" type="text/x-handlebars-template">

<div id="gdpr-cookie-message" role="dialog" aria-labelledby="labelCookies" aria-describedby="id_text_cookies">
	<div class="container">
		<div class="row">
			<div class="col-12 col-md-8 gpa-py-8">

				<div class="header-cookies">
					<h2 class="gpa-f-heading-s !mb-fluid-s" id="labelCookies">{{title}}</h2>
				</div>


				<div class="gpa-body-prose">
					
					<p id="id_text_cookies">{{message}} {{#if link}}<a href="{{link}}" tabindex="0">M&#225;s informaci&#243;n</a>{{/if}}</p>

					<div id="gdpr-cookie-types">
						<h3>{{cookieTypesTitle}}</h3>
						<div id="accordion" role="tablist" aria-multiselectable="true">
							{{#each cookieTypes}}
							<div class="card">

								<div class="card-header" role="tab" id="heading-{{@index}}">
									<div role="button" data-toggle="collapse" data-parent="#accordion" data-target="#collapse-{{@index}}" aria-expanded="false" aria-controls="collapse-{{@index}}">
										<strong>{{type}} ({{lista.length}})</strong>
										<!-- <span class="switch cookietype-{{value}}"></span> -->
										<div>{{description}}</div>
									</div>
								</div>
										
								<div id="collapse-{{@index}}" class="card-collapse collapse" role="tabpanel" aria-labelledby="heading-{{@index}}">
									<div class="card-body">
										<div class="table-responsive">								
											<table class="table">
												{{#each lista}}
												<tr>
													<td>{{@index}}</td>
													<td>
														{{#if required}}
															<div class="custom-control custom-switch">
																<input checked="checked" disabled="disabled" class="custom-control-input" type="checkbox" role="switch" value="{{name}}" name="gdpr[]" id="gdpr-cookietype-{{name}}" data-auto="on"/>
																<label class="custom-control-label" for="gdpr-cookietype-{{name}}">{{name}}</label>
															</div>
														{{else}}
															<div class="custom-control custom-switch">
																<input class="custom-control-input" type="checkbox" role="switch" name="gdpr[]" id="gdpr-cookietype-{{name}}" value="{{name}}" data-auto="on"/>
																<label class="custom-control-label" for="gdpr-cookietype-{{name}}">{{name}}</label>
															</div>
														{{/if}}
													</td>
													<td>{{description}}</td>
													<td>{{tipo}}</td>
													{{#if proveedor}}
														<td>{{proveedor}}</td>
													{{else}}
														<td>&nbsp;</td>
													{{/if}}
												</tr>
												{{/each}}
											</table>
										</div>
									</div>
								</div>
							</div>
							{{/each}}
						</div>
					</div>
				</div>

			
				<div class="footer-cookies">
					<div class="flex flex-wrap gap-xs">
						<button id="gdpr-cookie-accept-all" type="button" class="gpa-button gpa-button--primary">{{acceptBtnLabelAll}} <span class="sr-only">{{sronly}}</span></button>
						<button id="gdpr-cookie-accept" type="button" style="display:none" class="gpa-button gpa-button--primary-line">{{acceptBtnLabel}}</button>
						<button id="gdpr-cookie-advanced" type="button" class="gpa-button gpa-button--primary-line">{{advancedBtnLabel}}</button>
						<button id="gdpr-cookie-reject-all" type="button" class="gpa-button gpa-button--primary-line">{{rejectAll}} <span class="sr-only">{{sronly}}</span></button>
					</div>		
				</div>
			</div>

		</div>
	</div>

		

</div>
</script>

<script id="handlebars-cookie-confirm" type="text/x-handlebars-template">

<div id="gdpr-cookie-message" role="dialog" aria-labelledby="labelCookies">
	<div class="container">
		<div class="row">
			<div class="col-12 col-md-8 gpa-py-8">
				<div class="header-cookies"></div>
			
				<div class="gpa-body-prose">
					<p id="labelCookies" role="heading" aria-level="2">{{message-confirm-1}}<a onclick="launchCookies()" href="javascript:void(0);">{{message-confirm-link}}</a>{{message-confirm-2}}</p>
					<div id="gdpr-cookie-types">
						<h3>{{cookieTypesTitle}}</h3>
						<div id="accordion" role="tablist" aria-multiselectable="true">
							{{message-confirm}}
						</div>
					</div>
				</div>

				<div class="footer-cookies">
					<div class="flex flex-wrap space-x-2">
						<button id="gdpr-cookie-accept-post" type="button" class="gpa-button gpa-button--primary">{{hideBtnLabel}} <span class="sr-only">{{sronly}}</span></button>
					</div>		
				</div>
			</div>

		</div>
	</div>

		

</div>
</script>
 

	
	
					
				
			
		
	
	


