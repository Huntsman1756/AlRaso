                    <script> 
	$(document).ready(function(e) {		
		_pa_sede_bopa_web_portlet_SedeBopaSearchDateWeb_getCalendar($('#_pa_sede_bopa_web_portlet_SedeBopaSearchDateWeb_summaryMonth').val(), $('#_pa_sede_bopa_web_portlet_SedeBopaSearchDateWeb_summaryYear').val());
		 
		$('#_pa_sede_bopa_web_portlet_SedeBopaSearchDateWeb_summaryMonth').change(function() {
			var month =$(this).find('option:selected').val();
			var year = $('#_pa_sede_bopa_web_portlet_SedeBopaSearchDateWeb_summaryYear').find('option:selected').val();
			_pa_sede_bopa_web_portlet_SedeBopaSearchDateWeb_getCalendar(month, year);
		});
	
		$('#_pa_sede_bopa_web_portlet_SedeBopaSearchDateWeb_summaryYear').change(function() {
			var year =$(this).find('option:selected').val();
			var month = $('#_pa_sede_bopa_web_portlet_SedeBopaSearchDateWeb_summaryMonth').find('option:selected').val();
			_pa_sede_bopa_web_portlet_SedeBopaSearchDateWeb_getCalendar(month, year);
		});
		
		function _pa_sede_bopa_web_portlet_SedeBopaSearchDateWeb_getCalendar(month, year) {
			$.ajax({
				type : "GET",
				url : 'https://miprincipado.asturias.es/bopa?p_p_id=pa_sede_bopa_web_portlet_SedeBopaSearchDateWeb&p_p_lifecycle=2&p_p_state=normal&p_p_mode=view&p_p_resource_id=%2Fsearchdate%2Fcalendar&p_p_cacheability=cacheLevelPage',
				cache : false,
				data : {
					_pa_sede_bopa_web_portlet_SedeBopaSearchDateWeb_summaryMonth: month,
					_pa_sede_bopa_web_portlet_SedeBopaSearchDateWeb_summaryYear: year
					},
				success : function(calendarData) {
					$('#_pa_sede_bopa_web_portlet_SedeBopaSearchDateWeb_colum-full-calendar').empty();
					$('#_pa_sede_bopa_web_portlet_SedeBopaSearchDateWeb_colum-full-calendar').append(unescape(calendarData));
				}
			});
		}
	});
</script> <!-- 





















































