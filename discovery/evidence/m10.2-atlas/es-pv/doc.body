	//nOrden=parent.document.URL;
	//var lastPosition = nOrden.lastIndexOf('/bopv2/datos/');
	nOrden = document.URL;
	var lastPosition = nOrden.lastIndexOf('/bopv2/datos/');
	if (lastPosition==-1 && parent){
		nOrden = parent.document.URL;	
		lastPosition = nOrden.lastIndexOf('/bopv2/datos/');
	}
	if (lastPosition!=-1){
		lastPosition = lastPosition + '/bopv2/datos/'.length;
		nOrden=nOrden.substr(lastPosition,4)+'0'+nOrden.substr(lastPosition+10,5);
	}
}else {
	//nOrden = parent.document.getElementById("bopvNumOrden").value;
	if ($("#bopvNumOrden").length){
		nOrden=$("#bopvNumOrden").val();
	} else {
		nOrden = document.getElementById("bopvNumOrden").value;
	}
}
var w="600";
var h="300";
if (typeof screen!='undefined') {
 w = screen.availWidth/2;
 h = screen.availHeight/2;
}
if (window.showModalDialog) {
window.showModalDialog("/p43aBOPVWebWar/VerCalificacion.do?nOrden=" + nOrden + "&idioma=es&R01HNoPortal=true","calificacion",
"dialogWidth:"+w+"px;dialogHeight:"+h+"px;location:no;resizable=yes");
} else {
window.open("/p43aBOPVWebWar/VerCalificacion.do?nOrden=" + nOrden + "&idioma=es&R01HNoPortal=true","calificacion",
"height="+h+"px,width="+w+"px,toolbar=no,directories=no,status=no,menubar=no,scrollbars=no,location=no,resizable=yes,modal=yes");
}
}
</script> 
