<?xml version="1.0" encoding="UTF-8" standalone="no"?><akomaNtoso xmlns="http://docs.oasis-open.org/legaldocml/ns/akn/3.0" xmlns:eadop="https://portaljuridic.gencat.cat/eli-eadop#" xmlns:eadopakm="https://portaljuridic.gencat.cat/akm-eadop"><act contains="singleVersion" name="10"><meta><identification><FRBRWork><FRBRthis value="https://portaljuridic.gencat.cat/eli/es-ct/d/2003/02/04/39"/><FRBRuri value="https://portaljuridic.gencat.cat/eli/es-ct/d/2003/02/04/39"/><FRBRdate date="2003-02-19" name="Generation"/><FRBRauthor as="Author" href="Departament de Medi Ambient"/><FRBRcountry value="ES"/></FRBRWork><FRBRExpression><FRBRthis value="https://portaljuridic.gencat.cat/eli/es-ct/d/2003/02/04/39/dof"/><FRBRuri value="https://portaljuridic.gencat.cat/eli/es-ct/d/2003/02/04/39/dof"/><FRBRdate date="" name="Markup"/><FRBRlanguage language="CA"/></FRBRExpression><FRBRManifestation><FRBRthis value="https://portaljuridic.gencat.cat/eli/es-ct/d/2003/02/04/39/dof/cat/xml"/><FRBRuri value="https://portaljuridic.gencat.cat/eli/es-ct/d/2003/02/04/39/dof/cat/xml"/><FRBRdate date="" name="AKN_convertion"/><FRBRauthor as="editor" href="#eadop"/></FRBRManifestation></identification><publication date="2003-02-19" name="DOGC" number="01" showAs="Gazeta Oficial DOGC"/><classification source="#eurovoc"><keyword dictionary="EUROVOC" eId="2235" showAs="parc nacional" value="parc nacional"/></classification><lifecycle><eventRef date="2010-10-20" eId="318062" source="#ro1" type="generation"/></lifecycle><references><activeRef eId="37763" href="https://portaljuridic.gencat.cat/eli/es-ct/d/2003/02/04/39/dof" showAs="Afectació genèrica"/><TLCOrganization eId="autor" href=" " showAs="Departament de Medi Ambient"/><TLCOrganization eId="editor" href="/ontology/organizations/eadop" showAs="EADOP"/><TLCRole eId="autor" href="/ontology/role/author" showAs="Autor"/><TLCRole eId="editor" href="/ontology/role/editor" showAs="Editor"/></references><proprietary><eadop:Work><eadop:ComplexWork><eadop:EADOP eadop:name="uri_this">https://portaljuridic.gencat.cat/eli/es-ct/d/2003/02/04/39</eadop:EADOP><eadop:EADOP eadop:name="number">39</eadop:EADOP><eadop:EADOP eadop:name="uri_schema">/eli/{jurisdiction}/{type}/{year}/{month}/{day}/{number}/{version}/{version_date}/{language}/{format}</eadop:EADOP><eadop:EADOP eadop:name="type_document">http://www.elidata.es/mdr/authority/resource-type/1/d</eadop:EADOP><eadop:EADOP eadop:name="jurisdiction">http://www.elidata.es/mdr/authority/jurisdiction/1/es-ct</eadop:EADOP><eadop:EADOP eadop:name="responsibility_of">Departament de Medi Ambient</eadop:EADOP><eadop:EADOP eadop:name="date_document">2003-02-04</eadop:EADOP><eadop:EADOP eadop:name="date_publication">2003-02-19</eadop:EADOP><eadop:EADOP eadop:name="in_force">in force</eadop:EADOP><eadop:EADOP eadop:name="has_member">https://portaljuridic.gencat.cat/eli/es-ct/d/2003/02/04/39/dof</eadop:EADOP><eadop:EADOP eadop:name="is_about">parc nacional</eadop:EADOP></eadop:ComplexWork><eadop:LegalResource><eadop:EADOP eadop:name="uri_this">https://portaljuridic.gencat.cat/eli/es-ct/d/2003/02/04/39/dof</eadop:EADOP><eadop:EADOP eadop:name="number">39</eadop:EADOP><eadop:EADOP eadop:name="uri_schema">/eli/{jurisdiction}/{type}/{year}/{month}/{day}/{number}/{version}/{version_date}/{language}/{format}</eadop:EADOP><eadop:EADOP eadop:name="type_document">http://www.elidata.es/mdr/authority/resource-type/1/d</eadop:EADOP><eadop:EADOP eadop:name="jurisdiction">http://www.elidata.es/mdr/authority/jurisdiction/1/es-ct</eadop:EADOP><eadop:EADOP eadop:name="responsibility_of">Departament de Medi Ambient</eadop:EADOP><eadop:EADOP eadop:name="is_about">parc nacional</eadop:EADOP><eadop:EADOP eadop:name="version">http://www.elidata.es/mdr/authority/version/dof</eadop:EADOP><eadop:EADOP eadop:name="date_document">2003-02-04</eadop:EADOP><eadop:EADOP eadop:name="date_publication">2003-02-19</eadop:EADOP><eadop:EADOP eadop:name="in_force">in force</eadop:EADOP><eadop:EADOP eadop:name="is_member_of">https://portaljuridic.gencat.cat/eli/es-ct/d/2003/02/04/39</eadop:EADOP><eadop:EADOP eadop:name="realizes">https://portaljuridic.gencat.cat/eli/es-ct/d/2003/02/04/39/dof</eadop:EADOP><eadop:EADOP eadop:name="is_realized_by">https://portaljuridic.gencat.cat/eli/es-ct/d/2003/02/04/39/dof/cat</eadop:EADOP></eadop:LegalResource></eadop:Work><eadop:LegalExpression><eadop:EADOP eadop:name="uriThis">https://portaljuridic.gencat.cat/eli/es-ct/d/2003/02/04/39/dof/cat</eadop:EADOP><eadop:EADOP eadop:name="language">http://www.elidata.es/mdr/authority/language/cat</eadop:EADOP><eadop:EADOP eadop:name="title">DECRET 39/2003, de 4 de febrer, pel qual s'aprova el Pla rector d'ús i gestió del Parc Nacional d'Aigüestortes i Estany de Sant Maurici.</eadop:EADOP><eadop:EADOP eadop:name="publisher_agent ">https://dogc.gencat.cat/ca/sobre-el-dogc/eadop/</eadop:EADOP><eadop:EADOP eadop:name="embodies">https://portaljuridic.gencat.cat/eli/es-ct/d/2003/02/04/39/dof/cat</eadop:EADOP></eadop:LegalExpression><eadop:Manifestation><eadop:Format><eadop:EADOP eadop:name="uri_this">https://portaljuridic.gencat.cat/eli/es-ct/d/2003/02/04/39/dof/cat/turtle</eadop:EADOP><eadop:EADOP eadop:name="format">http://www.iana.org/assignments/media-types/text/turtle</eadop:EADOP><eadop:EADOP eadop:name="is_embodied_by">https://portaljuridic.gencat.cat/eli/es-ct/d/2003/02/04/39/dof/cat/turtle</eadop:EADOP><eadop:EADOP eadop:name="legal_value">oficial</eadop:EADOP></eadop:Format><eadop:Format><eadop:EADOP eadop:name="uri_this">https://portaljuridic.gencat.cat/eli/es-ct/d/2003/02/04/39/dof/cat/rdf</eadop:EADOP><eadop:EADOP eadop:name="format">http://www.iana.org/assignments/media-types/text/rdf</eadop:EADOP><eadop:EADOP eadop:name="is_embodied_by">https://portaljuridic.gencat.cat/eli/es-ct/d/2003/02/04/39/dof/cat/rdf</eadop:EADOP><eadop:EADOP eadop:name="legal_value">oficial</eadop:EADOP></eadop:Format><eadop:Format><eadop:EADOP eadop:name="uri_this">https://portaljuridic.gencat.cat/eli/es-ct/d/2003/02/04/39/dof/cat/pdf</eadop:EADOP><eadop:EADOP eadop:name="format">http://www.iana.org/assignments/media-types/application/pdf</eadop:EADOP><eadop:EADOP eadop:name="is_embodied_by">https://portaljuridic.gencat.cat/eli/es-ct/d/2003/02/04/39/dof/cat/pdf</eadop:EADOP><eadop:EADOP eadop:name="legal_value">oficial</eadop:EADOP></eadop:Format><eadop:Format><eadop:EADOP eadop:name="uri_this">https://portaljuridic.gencat.cat/eli/es-ct/d/2003/02/04/39/dof/cat/xml</eadop:EADOP><eadop:EADOP eadop:name="format">http://www.iana.org/assignments/media-types/text/xml</eadop:EADOP><eadop:EADOP eadop:name="is_embodied_by">https://portaljuridic.gencat.cat/eli/es-ct/d/2003/02/04/39/dof/cat/xml</eadop:EADOP><eadop:EADOP eadop:name="legal_value">oficial</eadop:EADOP></eadop:Format><eadop:Format><eadop:EADOP eadop:name="uri_this">https://portaljuridic.gencat.cat/eli/es-ct/d/2003/02/04/39/dof/cat/html</eadop:EADOP><eadop:EADOP eadop:name="format">http://www.iana.org/assignments/media-types/text/html</eadop:EADOP><eadop:EADOP eadop:name="is_embodied_by">https://portaljuridic.gencat.cat/eli/es-ct/d/2003/02/04/39/dof/cat/html</eadop:EADOP><eadop:EADOP eadop:name="legal_value">oficial</eadop:EADOP></eadop:Format><eadop:Format><eadop:EADOP eadop:name="published_in_format">https://dogc.gencat.cat/ca/</eadop:EADOP></eadop:Format></eadop:Manifestation></proprietary></meta><preface title="DECRET 39/2003, de 4 de febrer, pel qual s'aprova el Pla rector d'ús i gestió del Parc Nacional d'Aigüestortes i Estany de Sant Maurici."/><body><hcontainer><heading/><content period="&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Mitjan&amp;ccedil;ant la Llei 7/1988, de 30 de mar&amp;ccedil;, de reclassificaci&amp;oacute; del Parc Nacional d’Aig&amp;uuml;estortes i Estany de Sant Maurici, es va dotar d’un r&amp;egrave;gim jur&amp;iacute;dic especial l’esmentat Parc Nacional amb la finalitat de preservar-lo de totes les intervencions que poguessin alterar-ne la fisonomia, la integritat i l’evoluci&amp;oacute; dels sistemes naturals.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Aquesta Llei estableix que el Pla rector d’&amp;uacute;s i gesti&amp;oacute; ha de regular les mesures necess&amp;agrave;ries per protegir els valors naturals del Parc i que, d’entre altres, comprendran els aspectes relatius a les directrius generals d’ordenaci&amp;oacute; i d’&amp;uacute;s, les normes de gesti&amp;oacute; i actuaci&amp;oacute;, la zonificaci&amp;oacute; i la regulaci&amp;oacute; del tr&amp;agrave;nsit de persones i vehicles.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Mitjan&amp;ccedil;ant el Decret 82/1993, de 9 de febrer, es va aprovar el Pla rector d’&amp;uacute;s i gesti&amp;oacute; del Parc Nacional d’Aig&amp;uuml;estortes i Estany de Sant Maurici, la vig&amp;egrave;ncia del qual ha estat prorrogada pel Decret 223/2000, de 26 de juny. Escau ara aprovar un nou pla rector d’&amp;uacute;s i gesti&amp;oacute; que actualitzi el r&amp;egrave;gim jur&amp;iacute;dic de protecci&amp;oacute; del Parc. &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;El present Pla ha estat sotm&amp;egrave;s a informaci&amp;oacute; p&amp;uacute;blica, havent-se analitzat i valorat les al·legacions presentades. &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;El Pla que s’aprova per aquest Decret ha estat informat favorablement pel Patronat del Parc i per la Comissi&amp;oacute; de Coordinaci&amp;oacute; del mateix Parc, i s’ajusta al que preveu el Pla director de parcs nacionals, aprovat pel Reial decret 1803/1999, de 26 de novembre, que constitueix l’instrument d’ordenaci&amp;oacute; de la Xarxa de Parcs Nacionals.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;A proposta del conseller de Medi Ambient i d’acord amb el Govern,&lt;/P&gt;&#13;&#10;&lt;P&gt;Decreto:&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article &amp;uacute;nic&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;1.&amp;nbsp;S’aprova el Pla rector d’&amp;uacute;s i gesti&amp;oacute; del Parc Nacional d’Aig&amp;uuml;estortes i Estany de Sant Maurici.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;2.&amp;nbsp;El Pla rector d’&amp;uacute;s i gesti&amp;oacute; del Parc Nacional d’Aig&amp;uuml;estortes i Estany de Sant Maurici &amp;eacute;s integrat pels documents seg&amp;uuml;ents:&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Normes d’&amp;uacute;s i gesti&amp;oacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Programes d’activitats de gesti&amp;oacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Estimaci&amp;oacute; econ&amp;ograve;mica de les inversions.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Pl&amp;agrave;nols de zonificaci&amp;oacute; i de les zones d’&amp;uacute;s moderat. &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;3.&amp;nbsp;Les normes d’&amp;uacute;s i gesti&amp;oacute; es publiquen annexes a aquest Decret.&lt;/P&gt;&#13;&#10;&lt;P&gt;Disposici&amp;oacute; derogat&amp;ograve;ria&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Es deroga el Decret 82/1993, de 9 de febrer, pel qual s’aprova el Pla rector d’&amp;uacute;s i gesti&amp;oacute; del Parc Nacional d’Aig&amp;uuml;estortes i Estany de Sant Maurici.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Barcelona, 4 de febrer de 2003&lt;/P&gt;&#13;&#10;&lt;P&gt;Jordi Pujol &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;President de la Generalitat de Catalunya&lt;/P&gt;&#13;&#10;&lt;P&gt;Ramon Espadaler i Parcerisas&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Conseller de Medi Ambient&lt;/P&gt;&#13;&#10;&lt;P&gt;Normes&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;del Pla d’&amp;uacute;s i gesti&amp;oacute; del Parc Nacional d’Aig&amp;uuml;estortes i Estany de Sant Maurici &lt;/P&gt;&#13;&#10;&lt;P&gt;Cap&amp;iacute;tol I&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Disposicions de car&amp;agrave;cter general&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 1&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Objecte   &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;1.1&amp;nbsp;&amp;nbsp;L’objecte del Pla rector d’&amp;uacute;s i gesti&amp;oacute; del Parc Nacional d’Aig&amp;uuml;estortes i Estany de Sant Maurici &amp;eacute;s consolidar la protecci&amp;oacute; del Parc Nacional mitjan&amp;ccedil;ant una gesti&amp;oacute; adequada, d’acord amb el r&amp;egrave;gim jur&amp;iacute;dic especial que estableix la Llei 7/1988, de 30 de mar&amp;ccedil;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;1.2&amp;nbsp;&amp;nbsp;El present Pla estableix les normes que regulen els usos tur&amp;iacute;stics, recreatius, esportius, educatius i cient&amp;iacute;fics, aix&amp;iacute; com els usos i aprofitaments tradicionals i el tr&amp;agrave;nsit de persones i vehicles, i tamb&amp;eacute; defineix la planificaci&amp;oacute; de les l&amp;iacute;nies de gesti&amp;oacute; que determinin les actuacions a realitzar durant la seva vig&amp;egrave;ncia i els instruments d’actuaci&amp;oacute; per dur-les a terme.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 2&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Finalitats&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;El Pla rector d’&amp;uacute;s i gesti&amp;oacute; del Parc Nacional d’Aig&amp;uuml;estortes i Estany de Sant Maurici t&amp;eacute; com a finalitats:&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;a)&amp;nbsp;Assegurar el manteniment dels processos naturals i la restauraci&amp;oacute; dels recursos del Parc, amb la reducci&amp;oacute; i l’eliminaci&amp;oacute; dels impactes generats per activitats i actuacions incompatibles amb el car&amp;agrave;cter del Parc.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;b)&amp;nbsp;Implantar les mesures necess&amp;agrave;ries per aconseguir la protecci&amp;oacute; dels valors culturals del Parc.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;c)&amp;nbsp;Conservar els recursos naturals (gea, aig&amp;uuml;es, flora, fauna i paisatge).&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;d)&amp;nbsp;Assegurar la conservaci&amp;oacute; de les esp&amp;egrave;cies animals i vegetals silvestres que formen part dels processos naturals del Parc Nacional.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;e)&amp;nbsp;Desenvolupar les l&amp;iacute;nies b&amp;agrave;siques per definir el sistema d’&amp;uacute;s p&amp;uacute;blic i ordenaci&amp;oacute; de les visites de manera compatible amb la conservaci&amp;oacute; del Parc.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;f)&amp;nbsp;Fomentar el desenvolupament sostenible de les comarques implicades, amb la integraci&amp;oacute; de la poblaci&amp;oacute; de la zona en les activitats generades pel Parc Nacional, per compatibilitzar la protecci&amp;oacute; de la natura i la conservaci&amp;oacute; dels recursos naturals amb el desenvolupament socioecon&amp;ograve;mic.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;g)&amp;nbsp;Promoure l’educaci&amp;oacute;, la divulgaci&amp;oacute; i el coneixement p&amp;uacute;blic dels valors naturals i ecol&amp;ograve;gics i del seu significat, per potenciar una major sensibilitat p&amp;uacute;blica.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;h)&amp;nbsp;Promocionar la investigaci&amp;oacute; i el desenvolupament d’estudis del medi natural, aix&amp;iacute; com els relacionats amb les activitats humanes, els efectes de la gesti&amp;oacute; i el patrimoni etnol&amp;ograve;gic i cultural.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;i)&amp;nbsp;Potenciar la relaci&amp;oacute; amb la resta de parcs nacionals i espais protegits d’&amp;agrave;mbit internacional, nacional o auton&amp;ograve;mic.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;j)&amp;nbsp;Aconseguir el reconeixement internacional del Parc pels organismes competents en conservaci&amp;oacute; de la natura.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;k)&amp;nbsp;Promoure l’ampliaci&amp;oacute; del Parc Nacional en el futur, aix&amp;iacute; com l’adquisici&amp;oacute; de nous terrenys, amb una prevalen&amp;ccedil;a dels criteris cient&amp;iacute;fics i de conservaci&amp;oacute; per sobre dels altres, i tenint en compte la disponibilitat pressupost&amp;agrave;ria.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;l)&amp;nbsp;Estructurar un equip t&amp;egrave;cnic de gesti&amp;oacute; sota un organigrama de funcionament, amb l’establiment d’un sistema &amp;agrave;gil d’actuaci&amp;oacute; i administraci&amp;oacute;, completat amb una guarderia pr&amp;ograve;pia del Parc.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 3&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;&amp;Agrave;mbit territorial&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;3.1&amp;nbsp;&amp;nbsp;L’&amp;agrave;mbit territorial del Pla inclou el Parc Nacional i la zona perif&amp;egrave;rica de protecci&amp;oacute;, i ve definit pels l&amp;iacute;mits establerts a la Llei 7/1988 per al Parc Nacional; a la Llei 22/1990, de 28 de desembre, de modificaci&amp;oacute; parcial dels l&amp;iacute;mits de la zona perif&amp;egrave;rica de protecci&amp;oacute;, i al Decret 234/1996, de 5 de juliol, d’ampliaci&amp;oacute; del Parc Nacional d’Aig&amp;uuml;estortes i Estany de Sant Maurici.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;3.2&amp;nbsp;&amp;nbsp;La superf&amp;iacute;cie inclosa en l’&amp;agrave;mbit territorial del Pla &amp;eacute;s de 40.852 ha, que pertanyen als municipis de la Vall de Bo&amp;iacute;, Espot, Vielha e Mijaran, Naut Aran, Alt &amp;Agrave;neu, Esterri d’&amp;Agrave;neu, la Guingueta d’&amp;Agrave;neu, Sort, la Torre de Cabdella i Vilaller.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 4&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;R&amp;egrave;gim jur&amp;iacute;dic&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;El r&amp;egrave;gim jur&amp;iacute;dic del Parc Nacional d’Aig&amp;uuml;estortes i Estany de Sant Maurici i la seva zona perif&amp;egrave;rica de protecci&amp;oacute; s’estableix a la Llei 7/1988, de 30 de mar&amp;ccedil;, de reclassificaci&amp;oacute; del Parc Nacional d’Aig&amp;uuml;estortes i Estany de Sant Maurici; a la Llei 22/1990, de 28 de desembre, de modificaci&amp;oacute; parcial dels l&amp;iacute;mits de la zona perif&amp;egrave;rica de protecci&amp;oacute; del Parc Nacional d’Aig&amp;uuml;estortes i Estany de Sant Maurici; al Decret 234/1996, d’ampliaci&amp;oacute; del Parc Nacional d’Aig&amp;uuml;estortes i Estany de Sant Maurici i a les disposicions del present Decret.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 5&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Contingut&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;El Pla rector d’&amp;uacute;s i gesti&amp;oacute; &amp;eacute;s integrat pels documents seg&amp;uuml;ents:&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Normes d’&amp;uacute;s i gesti&amp;oacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Programes d’activitats de gesti&amp;oacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Estimaci&amp;oacute; econ&amp;ograve;mica de les inversions.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Pl&amp;agrave;nols de zonificaci&amp;oacute; i de les zones d’&amp;uacute;s moderat. &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 6&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Vig&amp;egrave;ncia&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;El Pla rector d’&amp;uacute;s i gesti&amp;oacute; t&amp;eacute; una vig&amp;egrave;ncia de sis anys. A partir del cinqu&amp;egrave; any s’iniciar&amp;agrave; el proc&amp;eacute;s per a la seva revisi&amp;oacute;.&lt;/P&gt;&#13;&#10;&lt;P&gt;Cap&amp;iacute;tol II&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Criteris de gesti&amp;oacute;&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 7&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Criteris generals &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;7.1&amp;nbsp;&amp;nbsp;S’ent&amp;eacute;n per gesti&amp;oacute; el conjunt de totes les activitats a desenvolupar per l’administraci&amp;oacute; del Parc Nacional durant el per&amp;iacute;ode de vig&amp;egrave;ncia del present Pla. El conjunt d’aquestes activitats constitueix el programa d’intervenci&amp;oacute; de l’administraci&amp;oacute; per complir els objectius establerts en la Llei 7/1988, de 30 de mar&amp;ccedil;, de reclassificaci&amp;oacute; del Parc Nacional d’Aig&amp;uuml;estortes i Estany de Sant Maurici.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;7.2&amp;nbsp;&amp;nbsp;Les actuacions que es duguin a terme en compliment dels objectius del Pla han d’atendre els criteris de gesti&amp;oacute; seg&amp;uuml;ents:&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;a)&amp;nbsp;En totes les actuacions que es programin durant la vig&amp;egrave;ncia del Pla prevaldr&amp;agrave; la conservaci&amp;oacute; dels valors i dels processos naturals.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;b)&amp;nbsp;Les actuacions que puguin afectar processos naturals es duran a terme en el menor grau possible d’intensitat, extensi&amp;oacute; i durada.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;c)&amp;nbsp;Les alteracions causades per fen&amp;ograve;mens naturals, com ara vents, allaus, llamps o inundacions, no seran restaurades excepte per motius de seguretat, de reparaci&amp;oacute; d’infraestructures o d’altres causes degudament justificades. &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;d)&amp;nbsp;La presa de decisions es basar&amp;agrave; en la millor informaci&amp;oacute; disponible i el principi de prevenci&amp;oacute;. En cas de dubte, prevaldr&amp;agrave; el principi de conservaci&amp;oacute;. &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;e)&amp;nbsp;Els mecanismes de gesti&amp;oacute; tindran en compte les relacions amb l’entorn del Parc.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;f)&amp;nbsp;Els projectes a desenvolupar en el marc del que estableix el Pla rector hauran de sotmetre’s al procediment d’avaluaci&amp;oacute; d’impacte ambiental, d’acord amb el que estableixen el Decret 328/1992, de 14 de desembre, d’aprovaci&amp;oacute; del Pla d’espais d’inter&amp;egrave;s natural, i la resta de normativa vigent en mat&amp;egrave;ria d’avaluaci&amp;oacute; d’impacte ambiental.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;g)&amp;nbsp;Es promour&amp;agrave; la col·laboraci&amp;oacute; de les persones propiet&amp;agrave;ries de terrenys amb l’administraci&amp;oacute; del Parc per tal de coadjuvar en l’assoliment dels objectius del Parc. Quan es consideri necessari per raons de gesti&amp;oacute;, es promour&amp;agrave; l’adquisici&amp;oacute; dels terrenys, preferentment mitjan&amp;ccedil;ant acords voluntaris, d’acord al que preveu l’apartat 3.1.e) del Pla director de la Xarxa de Parcs Nacionals.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;h)&amp;nbsp;S’implantaran progressivament sistemes normalitzats de qualitat ambiental, tant en els serveis que es presten mitjan&amp;ccedil;ant concessi&amp;oacute; i en els productes elaborats, com en la gesti&amp;oacute; del Parc.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 8&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Conservaci&amp;oacute; dels recursos geol&amp;ograve;gics, edafol&amp;ograve;gics i h&amp;iacute;drics&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Es preservar&amp;agrave; la integritat de les caracter&amp;iacute;stiques geol&amp;ograve;giques i geomorfol&amp;ograve;giques pr&amp;ograve;pies del Parc, i es mantindr&amp;agrave; i restaurar&amp;agrave; la qualitat i funcionalitat de les aig&amp;uuml;es superficials i subterr&amp;agrave;nies del Parc. A aquests efectes es duran a terme les actuacions seg&amp;uuml;ents:&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;a)&amp;nbsp;Es protegiran els s&amp;ograve;ls de l’erosi&amp;oacute; no natural, de les activitats d’extracci&amp;oacute; i dels processos de contaminaci&amp;oacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;b)&amp;nbsp;Es duran a terme actuacions de restauraci&amp;oacute;, en &amp;agrave;rees en qu&amp;egrave; les condicions hagin estat alterades artificialment.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;c)&amp;nbsp;Es protegir&amp;agrave; el r&amp;egrave;gim h&amp;iacute;dric natural de rius, rierols, estanys, brolladors i aq&amp;uuml;&amp;iacute;fers.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 9&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Conservaci&amp;oacute; dels recursos gen&amp;egrave;tics&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;9.1&amp;nbsp;&amp;nbsp;Les actuacions que es duguin a terme en l’&amp;agrave;mbit del Parc es realitzaran minimitzant les interfer&amp;egrave;ncies humanes que puguin afectar la diversitat gen&amp;egrave;tica.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;9.2&amp;nbsp;&amp;nbsp;La conservaci&amp;oacute; de la vegetaci&amp;oacute; es realitzar&amp;agrave; vetllant pel manteniment del patrimoni gen&amp;egrave;tic.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;9.3&amp;nbsp;&amp;nbsp;En la recuperaci&amp;oacute; de la flora i fauna aut&amp;ograve;ctones s’utilitzaran, si escau, organismes de les poblacions gen&amp;egrave;ticament m&amp;eacute;s pr&amp;ograve;ximes i ecol&amp;ograve;gicament m&amp;eacute;s properes a les poblacions del Parc. Els trasllats d’organismes amb l’objectiu de restaurar la diversitat gen&amp;egrave;tica es fonamentaran en estudis previs d’investigaci&amp;oacute; sobre la compatibilitat gen&amp;egrave;tica de les poblacions.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;9.4&amp;nbsp;&amp;nbsp;Les actuacions de maneig que impliquin plantaci&amp;oacute; o translaci&amp;oacute; d’esp&amp;egrave;cies, subesp&amp;egrave;cies o varietats, es basaran en el coneixement de les seves adaptacions locals, &amp;agrave;rees i requeriments d’h&amp;agrave;bitat, i en un coneixement exhaustiu de la hist&amp;ograve;ria ecol&amp;ograve;gica de l’&amp;agrave;rea.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;9.5&amp;nbsp;&amp;nbsp;L’extracci&amp;oacute; d’organismes per raons de control de poblacions o eradicaci&amp;oacute; de plagues haur&amp;agrave; de tenir en compte la necessitat de mantenir nivells apropiats de diversitat gen&amp;egrave;tica en les poblacions residuals del Parc. Es faran servir mesures de car&amp;agrave;cter biologicoselectiu, sempre que sigui possible. &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;9.6&amp;nbsp;&amp;nbsp;Es promour&amp;agrave; l’eradicaci&amp;oacute; de les poblacions d’esp&amp;egrave;cies al·l&amp;ograve;ctones de flora i fauna que es trobin al Parc Nacional. Nom&amp;eacute;s en casos extraordinaris i justificats, es podran establir excepcions a l’eradicaci&amp;oacute; per a les esp&amp;egrave;cies ja integrades en els processos naturals i la desaparici&amp;oacute; de les quals pugui menyscabar la conservaci&amp;oacute; d’altres esp&amp;egrave;cies natives.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 10&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Conservaci&amp;oacute; de la flora i la fauna&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Amb l’objecte de preservar els processos naturals, mantenir la diversitat gen&amp;egrave;tica del Parc Nacional i restaurar els seus sistemes naturals es seguiran els criteris de gesti&amp;oacute; seg&amp;uuml;ents:&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;a)&amp;nbsp;La revegetaci&amp;oacute; es realitzar&amp;agrave;, si escau, amb esp&amp;egrave;cies o t&amp;agrave;xons natius de la mateixa zona del Parc en qu&amp;egrave; es realitza aquesta restauraci&amp;oacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;b)&amp;nbsp;Es minimitzaran els impactes humans en la din&amp;agrave;mica natural de les poblacions.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;c)&amp;nbsp;El maneig poblacional i el control d’esp&amp;egrave;cies animals que s’hi associa es justificaran pel manteniment dels processos ecol&amp;ograve;gics del Parc i estaran orientats a assegurar la conservaci&amp;oacute; dels h&amp;agrave;bitats naturals, la seva funcionalitat i els seus processos, i la protecci&amp;oacute; de les poblacions d’esp&amp;egrave;cies amena&amp;ccedil;ades. Es desenvoluparan actuacions en relaci&amp;oacute; amb les esp&amp;egrave;cies end&amp;egrave;miques, amena&amp;ccedil;ades, sobreabundants i al·l&amp;ograve;ctones, aix&amp;iacute; com amb aquelles desaparegudes la reintroducci&amp;oacute; de les quals es jutgi adequada, en la mesura que ho permetin les condicions naturals, i sempre que els estudis cient&amp;iacute;fics ho aconsellin.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;d)&amp;nbsp;Les plagues i epid&amp;egrave;mies es controlaran en el cas que puguin afectar la conservaci&amp;oacute; d’esp&amp;egrave;cies o comunitats amena&amp;ccedil;ades, la seguretat, la salut o els interessos de persones o quan puguin afectar l’exterior del Parc. En tot cas, prevaldr&amp;agrave; el principi de m&amp;iacute;nima intervenci&amp;oacute; i la utilitzaci&amp;oacute; de m&amp;egrave;todes de control selectius, compatibles amb les exig&amp;egrave;ncies de l’&amp;uacute;s p&amp;uacute;blic i menys agressius per al medi.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 11&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Conservaci&amp;oacute; del paisatge&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;El paisatge del Parc Nacional d’Aig&amp;uuml;estortes i Estany de Sant Maurici es preserva mitjan&amp;ccedil;ant el compliment dels seg&amp;uuml;ents requeriments:&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;a)&amp;nbsp;Els nous projectes incorporaran el criteri de m&amp;iacute;nim impacte visual. En les infraestructures i instal·lacions existents es promour&amp;agrave; la seva adequaci&amp;oacute; a les tipologies tradicionals pr&amp;ograve;pies de la zona d’influ&amp;egrave;ncia del Parc Nacional, la major integraci&amp;oacute; en el seu entorn i la reducci&amp;oacute; al m&amp;iacute;nim de les afeccions paisatg&amp;iacute;stiques negatives, tant per la seva forma com pels seus materials o el seu acabat. S’evitar&amp;agrave; la compet&amp;egrave;ncia entre l’element artificial i els valors naturals.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;b)&amp;nbsp;Es considerar&amp;agrave; priorit&amp;agrave;ria la restauraci&amp;oacute; d’&amp;agrave;rees afectades per les activitats d’extinci&amp;oacute; d’incendis.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;c)&amp;nbsp;En els projectes i actuacions que afectin les pistes del Parc es donar&amp;agrave; prioritat als factors mediambientals i a la seva integraci&amp;oacute; en l’entorn.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;d)&amp;nbsp;S’eliminaran les estructures artificials innecess&amp;agrave;ries i abandonades. En els casos en qu&amp;egrave; no en sigui possible l’eliminaci&amp;oacute;, s’estudiaran mesures per a la seva integraci&amp;oacute; en l’entorn.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 12&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;&amp;Uacute;s p&amp;uacute;blic i visites&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;12.1&amp;nbsp;&amp;nbsp;&amp;Eacute;s configurar&amp;agrave; un sistema d’&amp;uacute;s p&amp;uacute;blic de lliure acc&amp;eacute;s, divers i suficient, adaptat a les caracter&amp;iacute;stiques naturals del Parc Nacional, a la disponibilitat de mitjans i infraestructures sota control de l’Administraci&amp;oacute;, a la seva capacitat d’acollida, a la demanda existent i a la seva evoluci&amp;oacute; previsible. &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;12.2&amp;nbsp;&amp;nbsp;L’oferta tur&amp;iacute;stica, el tr&amp;agrave;nsit i l’accessibilitat rodada s’ordenar&amp;agrave; mitjan&amp;ccedil;ant la creaci&amp;oacute; de vies per a vianants i la utilitzaci&amp;oacute; de mitjans de transport col·lectius i limitats. S’assegurar&amp;agrave; la disponibilitat, accessibilitat, diversitat i alta qualitat de l’oferta d’instal·lacions i serveis destinats al gaudi dels valors del Parc i a l’educaci&amp;oacute; ambiental. Amb aquestes finalitats s’han de dur a terme les seg&amp;uuml;ents actuacions:&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;a)&amp;nbsp;Orientaci&amp;oacute; als i les visitants i prestaci&amp;oacute; d’una informaci&amp;oacute; personalitzada sobre les opcions d’&amp;uacute;s p&amp;uacute;blic.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;b)&amp;nbsp;Oferta de serveis interpretatius que mostrin als i les visitants el significat natural i cultural d’Aig&amp;uuml;estortes i Estany de Sant Maurici.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;c)&amp;nbsp;Desenvolupament de programes d’educaci&amp;oacute; i interpretaci&amp;oacute; ambiental destinats a l’entorn del Parc Nacional i p&amp;uacute;blic en general.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;d)&amp;nbsp;Exist&amp;egrave;ncia dels serveis indispensables per organitzar i controlar l’&amp;uacute;s p&amp;uacute;blic del Parc, de manera que es combini la millor experi&amp;egrave;ncia per al i la visitant i la m&amp;agrave;xima protecci&amp;oacute; dels recursos.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;e)&amp;nbsp;Oferta de diferents opcions per al gaudi de la natura de manera que s’atengui la demanda d’&amp;uacute;s p&amp;uacute;blic.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;f)&amp;nbsp;Prestar especial atenci&amp;oacute; a l’excursionisme practicat tradicionalment en el Parc i respectu&amp;oacute;s amb els valors ecol&amp;ograve;gics. &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;g)&amp;nbsp;Facilitar l’acc&amp;eacute;s a persones discapacitades als centres de visitants, als itineraris i a la resta de serveis d’&amp;uacute;s p&amp;uacute;blic del Parc.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;h)&amp;nbsp;Dotaci&amp;oacute; de serveis de transport p&amp;uacute;blic adequats que facilitin la circulaci&amp;oacute; als visitants i la pr&amp;agrave;ctica excursionista i garanteixin la preservaci&amp;oacute; i gaudi dels recursos del Parc.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;i)&amp;nbsp;Implantaci&amp;oacute; d’instal·lacions i infraestructures necess&amp;agrave;ries per als diferents serveis respectant-se l’entorn en qu&amp;egrave; es localitzin, promovent la minimitzaci&amp;oacute; de producci&amp;oacute; de residus s&amp;ograve;lids i optimitzant la seva efici&amp;egrave;ncia energ&amp;egrave;tica. Les instal·lacions s’ubicaran preferentment a l’exterior del Parc, i a ser possible en les poblacions de l’entorn.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;j)&amp;nbsp;Manteniment d’una xarxa de centres de visitants com a lloc preferent des d’on iniciar una visita, i complementar-la amb un conjunt de punts informatius d’atenci&amp;oacute; directa al p&amp;uacute;blic.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;k)&amp;nbsp;Senyalitzaci&amp;oacute; informativa i interpretativa dels llocs d’inter&amp;egrave;s per al i la visitant com ara accessos, miradors, &amp;agrave;rees d’&amp;uacute;s p&amp;uacute;blic, aparcaments de les entrades al Parc i parades de transport p&amp;uacute;blic.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;l)&amp;nbsp;Desenvolupament d’un sistema d’autofinan&amp;ccedil;ament per a la implantaci&amp;oacute; de  serveis complementaris a l’&amp;uacute;s p&amp;uacute;blic.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 13&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Activitats d’investigaci&amp;oacute;&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Les activitats d’investigaci&amp;oacute; al Parc Nacional d’Aig&amp;uuml;estortes i Estany de Sant Maurici han de complir alguns dels requisits seg&amp;uuml;ents:&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;a)&amp;nbsp;Proporcionar informaci&amp;oacute; b&amp;agrave;sica per a la gesti&amp;oacute; del Parc i per a la presa de decisions.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;b)&amp;nbsp;Desenvolupar estrat&amp;egrave;gies per evitar o minimitzar impactes negatius de l’&amp;uacute;s p&amp;uacute;blic sobre els recursos.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;c)&amp;nbsp;Determinar les causes dels problemes detectats en el maneig de recursos incl&amp;ograve;s en el programa d’activitats de gesti&amp;oacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;d)&amp;nbsp;Aportar resultats d’estudis concrets que completin la informaci&amp;oacute; existent sobre les implicacions en l’&amp;uacute;s dels recursos, com a mitj&amp;agrave; per aconseguir la seva compatibilitat amb els objectius de conservaci&amp;oacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;e)&amp;nbsp;Dissenyar alternatives de recuperaci&amp;oacute; i desenvolupar m&amp;egrave;todes de restauraci&amp;oacute; de recursos alterats per causes antr&amp;ograve;piques.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;f)&amp;nbsp;Con&amp;egrave;ixer els ecosistemes, els seus components, el seu estat i la seva funcionalitat, amb el desenvolupament d’una base de dades integrades que faciliti la gesti&amp;oacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 14&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Seguiment dels recursos del Parc&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;14.1&amp;nbsp;&amp;nbsp;Es dur&amp;agrave; a terme un programa de seguiment dels recursos del parc amb la finalitat de resoldre les mancances d’informaci&amp;oacute; que s’observin en el desenvolupament de les activitats de la gesti&amp;oacute; realitzada per l’administraci&amp;oacute; del Parc. Aquest programa contindr&amp;agrave; la informaci&amp;oacute; seg&amp;uuml;ent:&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;a)&amp;nbsp;Dades sobre la natura i l’estat dels principals recursos naturals bi&amp;ograve;tics i abi&amp;ograve;tics.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;b)&amp;nbsp;Els possibles indicadors que permetin seguir l’evoluci&amp;oacute; anual dels recursos del Parc Nacional, aix&amp;iacute; com la implantaci&amp;oacute; d’un sistema d’avaluaci&amp;oacute; de les mesures adoptades per a la seva conservaci&amp;oacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;14.2&amp;nbsp;&amp;nbsp;Les decisions de maneig s’adoptaran partir de la informaci&amp;oacute; cient&amp;iacute;fica obtinguda. &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 15&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Relacions amb l’entorn i difusi&amp;oacute;&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Per aconseguir la coordinaci&amp;oacute; en la gesti&amp;oacute; de l’administraci&amp;oacute; del Parc i promoure la cooperaci&amp;oacute; i participaci&amp;oacute; de la societat, es duran a terme les seg&amp;uuml;ents actuacions:&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;a)&amp;nbsp;Control del compliment de la normativa de protecci&amp;oacute; del Parc perqu&amp;egrave; es mantingui la compatibilitat entre el desenvolupament sostenible i la preservaci&amp;oacute; dels valors naturals.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;b)&amp;nbsp;Implantaci&amp;oacute; d’un sistema de relaci&amp;oacute; permanent i fluid amb les comunitats de l’entorn i les persones titulars de drets a l’interior del Parc, orientat a la millor consecuci&amp;oacute; dels seus objectius.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;c)&amp;nbsp;Divulgaci&amp;oacute; entre les comunitats locals de la import&amp;agrave;ncia dels valors del Parc i els beneficis indirectes generats per la seva exist&amp;egrave;ncia. En aquest &amp;agrave;mbit es prestar&amp;agrave; una atenci&amp;oacute; priorit&amp;agrave;ria a la poblaci&amp;oacute; escolar.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;d)&amp;nbsp;Promoci&amp;oacute; de l’estudi i coneixement socioecon&amp;ograve;mic i cultural de l’entorn del Parc en el marc del seu desenvolupament sostenible.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;e)&amp;nbsp;Desenvolupament de mesures i l&amp;iacute;nies d’acci&amp;oacute; per tal d’implicar a l’Administraci&amp;oacute; local, les comunitats de l’entorn, les empreses p&amp;uacute;bliques i privades i el p&amp;uacute;blic en general en la defensa i protecci&amp;oacute; dels valors del Parc.&lt;/P&gt;&#13;&#10;&lt;P&gt;Cap&amp;iacute;tol III&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Zonificaci&amp;oacute; del territori del Parc&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 16&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Criteris de zonificaci&amp;oacute; &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Es zonifica el territori del Parc en funci&amp;oacute; del valor dels seus recursos i la seva capacitat d’acollida, per minimitzar els impactes negatius i assegurar l’&amp;uacute;s de l’espai compatible amb la conservaci&amp;oacute; dels seus recursos naturals. Les zones es descriuen geogr&amp;agrave;ficament en l’annex 1 del present Pla.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 17&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Zones&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;S’estableixen al territori del Parc Nacional les zones seg&amp;uuml;ents, previstes en el Pla director de parcs nacionals:&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;a)&amp;nbsp;Zona d’&amp;uacute;s especial.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Constitu&amp;iuml;da per &amp;agrave;rees d’extensi&amp;oacute; redu&amp;iuml;da en qu&amp;egrave; s’ubiquen les construccions i instal·lacions majors, la localitzaci&amp;oacute; de les quals a l’interior del Parc es considera necess&amp;agrave;ria. Tamb&amp;eacute; alberga, amb criteris de m&amp;iacute;nim impacte i de concentraci&amp;oacute; de serveis, les instal·lacions que calgui establir per a l’&amp;uacute;s p&amp;uacute;blic i per a les activitats de gesti&amp;oacute; i administraci&amp;oacute;. Inclou tamb&amp;eacute; les instal·lacions preexistents que sigui necessari mantenir, aix&amp;iacute; com aquelles altres que hagin d’acollir serveis d’inter&amp;egrave;s general conformes amb la finalitat del Parc. Estan preparades per suportar un &amp;uacute;s p&amp;uacute;blic intens.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;b)&amp;nbsp;Zona d’&amp;uacute;s moderat.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Constitu&amp;iuml;da per &amp;agrave;rees dominades per un ambient natural amb major capacitat per acollir visitants que en el cas de les zones d’&amp;uacute;s restringit i de reserva. La seva conservaci&amp;oacute; &amp;eacute;s compatible amb un &amp;uacute;s p&amp;uacute;blic moderat. &amp;Eacute;s el territori del Parc Nacional que per la seva extensi&amp;oacute; configura unitats naturals o paisatg&amp;iacute;stiques clares, on la vegetaci&amp;oacute;, la flora i la fauna poden desenvolupar-se de manera natural.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;c)&amp;nbsp;Zona d’&amp;uacute;s restringit.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Est&amp;agrave; constitu&amp;iuml;da per &amp;agrave;rees que, encara que hagin pogut sofrir un cert grau d’intervenci&amp;oacute; humana, presenten un elevat grau de naturalitat, mantenen els seus valors naturals en un bon estat o es troben en fase de regeneraci&amp;oacute; i que poden suportar un cert nivell d’&amp;uacute;s p&amp;uacute;blic. Es tracta d’&amp;agrave;rees del Parc Nacional on conflueixen diversos valors d’inter&amp;egrave;s ecol&amp;ograve;gic, cient&amp;iacute;fic i paisatg&amp;iacute;stic, per la seva representativitat, diversitat i/o vulnerabilitat del conjunt o d’alguns dels seus elements. La seva preservaci&amp;oacute; &amp;eacute;s compatible amb un &amp;uacute;s p&amp;uacute;blic limitat.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;d)&amp;nbsp;Zona de reserva.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Constitu&amp;iuml;da per aquelles &amp;agrave;rees, contig&amp;uuml;es o disperses, que requereixen el m&amp;agrave;xim grau de protecci&amp;oacute; o aquelles altres en qu&amp;egrave; no es pot autoritzar cap tipus d’&amp;uacute;s p&amp;uacute;blic. Aquestes &amp;agrave;rees compleixen, almenys, algunes de les caracter&amp;iacute;stiques seg&amp;uuml;ents: &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;1.&amp;nbsp;Contenir valors naturals de primera magnitud d’acord amb la seva raresa, fragilitat, biodiversitat i inter&amp;egrave;s cient&amp;iacute;fic.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;2.&amp;nbsp;Englobar processos de regeneraci&amp;oacute; o d’estudi dels recursos naturals.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;3.&amp;nbsp;Ser inadequades per a l’&amp;uacute;s p&amp;uacute;blic. La gesti&amp;oacute; hi pot variar des de l’abstenci&amp;oacute; fins al maneig actiu, per&amp;ograve; sempre tindr&amp;agrave; com a fi la conservaci&amp;oacute; del seu car&amp;agrave;cter.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 18&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Territori de la zona perif&amp;egrave;rica de protecci&amp;oacute;&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;S’estableixen al territori de la zona perif&amp;egrave;rica de protecci&amp;oacute; les zones seg&amp;uuml;ents:&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;a)&amp;nbsp;Zona perif&amp;egrave;rica d’&amp;uacute;s especial.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Constitu&amp;iuml;da per les &amp;agrave;rees d’extensi&amp;oacute; redu&amp;iuml;da de la zona perif&amp;egrave;rica de protecci&amp;oacute; del Parc Nacional preparades per suportar un &amp;uacute;s p&amp;uacute;blic intens.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;b)&amp;nbsp;Zona d’especial inter&amp;egrave;s ecol&amp;ograve;gic i paisatg&amp;iacute;stic.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Constitu&amp;iuml;da per les &amp;agrave;rees de la zona perif&amp;egrave;rica de protecci&amp;oacute; que, pels valors ecol&amp;ograve;gics, cient&amp;iacute;fics i paisatg&amp;iacute;stics que atresoren, o per la representativitat, diversitat i/o vulnerabilitat del conjunt o d’alguns dels seus elements, necessiten una regulaci&amp;oacute; d’usos que en garanteixi la conservaci&amp;oacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;c)&amp;nbsp;Zona de reserva integral.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;S&amp;oacute;n aquells espais de la zona perif&amp;egrave;rica de protecci&amp;oacute; que, pel fet d’acollir ecosistemes amb rellevants valors ecol&amp;ograve;gics, cient&amp;iacute;fics i paisatg&amp;iacute;stics i de gran singularitat i fragilitat, s&amp;oacute;n mereixedors de les m&amp;agrave;ximes mesures de protecci&amp;oacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;d)&amp;nbsp;Zona de protecci&amp;oacute; exterior.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Inclou tot el territori de la zona perif&amp;egrave;rica de protecci&amp;oacute; no incl&amp;ograve;s en les zones descrites als apartats anteriors.&lt;/P&gt;&#13;&#10;&lt;P&gt;Cap&amp;iacute;tol IV&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Normes de protecci&amp;oacute; &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 19&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Protecci&amp;oacute; de la flora i la fauna&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Resten prohibides les actuacions seg&amp;uuml;ents:&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;a)&amp;nbsp;La destrucci&amp;oacute; de la vegetaci&amp;oacute;, la recol·lecci&amp;oacute;, la tala i el desarrelament o la destrucci&amp;oacute; d’exemplars d’esp&amp;egrave;cies vegetals o d’alguna de les seves parts, incloses les llavors, aix&amp;iacute; com la seva comercialitzaci&amp;oacute;, excepte en els casos previstos en el present pla. A la zona perif&amp;egrave;rica de protecci&amp;oacute;, exceptuant la zona de reserva integral, &amp;uacute;nicament est&amp;agrave; permesa la recol·lecci&amp;oacute; de bolets i els aprofitaments forestals subjectes al seu pla de gesti&amp;oacute; aprovat per l’Administraci&amp;oacute;. &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;b)&amp;nbsp;La ca&amp;ccedil;a i la pesca esportives en tot el territori del Parc Nacional. En casos excepcionals, plenament justificats i sota supervisi&amp;oacute; de l’administraci&amp;oacute; del Parc Nacional, podr&amp;agrave; permetre’s la captura d’animals com a sistema de control de poblacions, amb l’informe previ del Consell de Protecci&amp;oacute; de la Natura. A la zona perif&amp;egrave;rica de protecci&amp;oacute;, excepte a la zona de reserva integral, aquesta activitat pot ser autoritzada, subjecta al seu pla de gesti&amp;oacute; corresponent, aprovat per l’Administraci&amp;oacute;. &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;c)&amp;nbsp;La pertorbaci&amp;oacute;, persecuci&amp;oacute;, captura i comercialitzaci&amp;oacute; de les esp&amp;egrave;cies animals silvestres, de les seves despulles o fragments i, en el cas d’esp&amp;egrave;cies ov&amp;iacute;pares, dels seus ous i nius. A la zona perif&amp;egrave;rica n’&amp;eacute;s excepci&amp;oacute; la ca&amp;ccedil;a, activitat subjecta a les disposicions establertes en l’apartat anterior.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;d)&amp;nbsp;La introducci&amp;oacute; d’esp&amp;egrave;cies vegetals i animals ex&amp;ograve;tiques. En cas de produir-se aquesta introducci&amp;oacute;, l’Administraci&amp;oacute; s’encarregar&amp;agrave; de la seva eradicaci&amp;oacute;, sens perjudici de la repercussi&amp;oacute; de les despeses que se’n derivin sobre els responsables.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;e)&amp;nbsp;La utilitzaci&amp;oacute; de meg&amp;agrave;fons, l’&amp;uacute;s de r&amp;agrave;dios o altres instruments que puguin pertorbar la tranquil·litat del Parc.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 20&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Protecci&amp;oacute; dels recursos h&amp;iacute;drics&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;20.1&amp;nbsp;&amp;nbsp;Es prohibeix efectuar accions sobre el medi f&amp;iacute;sic o biol&amp;ograve;gic vinculat a l’aigua que constitueixin o puguin constituir-ne una degradaci&amp;oacute; de la qualitat fisicoqu&amp;iacute;mica. &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;20.2&amp;nbsp;&amp;nbsp;No poden efectuar-se abocaments directes o indirectes que contaminin les aig&amp;uuml;es i acumular residus s&amp;ograve;lids, enderrocs o subst&amp;agrave;ncies, qualsevol que sigui la seva natura i el lloc on es dipositin, que constitueixin o puguin constituir un perill de contaminaci&amp;oacute; de les aig&amp;uuml;es o degradaci&amp;oacute; del seu entorn.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;20.3&amp;nbsp;&amp;nbsp;Els expedients de concessi&amp;oacute; per a l’explotaci&amp;oacute; d’aig&amp;uuml;es superficials o subterr&amp;agrave;nies requereixen l’informe previ favorable del Patronat.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;20.4&amp;nbsp;&amp;nbsp;No est&amp;agrave; permesa la implantaci&amp;oacute; de nous aprofitaments hidroel&amp;egrave;ctrics. Nom&amp;eacute;s es podran autoritzar obres de condicionament de les instal·lacions hidroel&amp;egrave;ctriques existents. No es renovaran les concessions quan aquestes s’extingeixen.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;20.5&amp;nbsp;&amp;nbsp;Qualsevol actuaci&amp;oacute; que es projecti i que pugui tenir incid&amp;egrave;ncia en el medi h&amp;iacute;dric haur&amp;agrave; de garantir el pas de la fauna pisc&amp;iacute;cola, amb la previsi&amp;oacute;, quan escaigui, de la construcci&amp;oacute; d’escales pisc&amp;iacute;coles.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 21&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Protecci&amp;oacute; del s&amp;ograve;l i dels recursos geol&amp;ograve;gics, culturals i del paisatge&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;21.1&amp;nbsp;&amp;nbsp;Es prohibeixen les actuacions que suposin alteraci&amp;oacute; del s&amp;ograve;l, de les roques o el relleu (moviments de terra, voladures de roques, extraccions de pedres i f&amp;ograve;ssils i altres extraccions semblants), excepte les necess&amp;agrave;ries per a les actuacions previstes en el present Pla i en els seus programes de desenvolupament. Els projectes t&amp;egrave;cnics que es redactin en aquestes actuacions hauran de preveure la restauraci&amp;oacute; dels terrenys afectats, d’acord amb els requeriments i del corresponent projecte de restauraci&amp;oacute; ambiental aprovat. &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;21.2&amp;nbsp;&amp;nbsp;Es prohibeix la instal·laci&amp;oacute; de casetes, cabanes i para-sols, aix&amp;iacute; com qualsevol element que produeixi contaminaci&amp;oacute; lum&amp;iacute;nica o visual.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;21.3&amp;nbsp;&amp;nbsp;Les entitats privades que facin explotacions s’hauran de responsabilitzar de l’evacuaci&amp;oacute; dels residus que generin. &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;21.4&amp;nbsp;&amp;nbsp;Es prohibeix la realitzaci&amp;oacute; d’inscripcions, senyals, signes i dibuixos en pedres, prats, arbres, panells informatius i en general qualsevol tipus de b&amp;eacute; moble o immoble, excepte les inscripcions relatives a la xarxa de senders, d’acord amb el que es preveu al programa d’activitats en mat&amp;egrave;ria d’&amp;uacute;s p&amp;uacute;blic i visites. &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;21.5&amp;nbsp;&amp;nbsp;Les obres d’infraestructures p&amp;uacute;bliques o privades han de limitar els efectes sobre la integritat de la natura, minimitzar l’impacte ecol&amp;ograve;gic i paisatg&amp;iacute;stic, i prendre, quan procedeixi, mesures per a la restauraci&amp;oacute; o el condicionament de les &amp;agrave;rees alterades. El projecte d’obra haur&amp;agrave; de sotmetre’s al procediment d’avaluaci&amp;oacute; d’impacte ambiental quan sigui exigida per la normativa vigent. &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 22&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Investigaci&amp;oacute;&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;22.1&amp;nbsp;&amp;nbsp;La investigaci&amp;oacute; promoguda per organismes i entitats externes ha de ser autoritzada per l’administraci&amp;oacute; del Parc d’acord amb els criteris previstos a l’article 13 d’aquest Pla.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;22.2&amp;nbsp;&amp;nbsp;Els projectes d’investigaci&amp;oacute; hauran de ser avalats per una instituci&amp;oacute; cient&amp;iacute;fica o acad&amp;egrave;mica solvent. L’autoritzaci&amp;oacute; per al seu desenvolupament implicar&amp;agrave; el sotmetiment en la seva execuci&amp;oacute; a les condicions establertes per l’administraci&amp;oacute; del Parc, aix&amp;iacute; com l’obligatorietat de remetre una c&amp;ograve;pia completa dels treballs realitzats i de les publicacions a qu&amp;egrave; donessin lloc, on caldria que se cit&amp;eacute;s la participaci&amp;oacute; del Parc Nacional en el seu desenvolupament. La informaci&amp;oacute; relativa a esp&amp;egrave;cies catalogades requerir&amp;agrave; autoritzaci&amp;oacute; de l’administraci&amp;oacute; del Parc per ser distribu&amp;iuml;da. En tots els casos es podr&amp;agrave; fomentar la divulgaci&amp;oacute; dels resultats de les investigacions a trav&amp;eacute;s de les publicacions de les Jornades d’Investigaci&amp;oacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;22.3&amp;nbsp;&amp;nbsp;Els projectes d’investigaci&amp;oacute; presentats per les persones o entitats alienes al Parc Nacional, es regeixen per les normes seg&amp;uuml;ents: &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;a)&amp;nbsp;Es presentar&amp;agrave; un projecte previ on s’indicar&amp;agrave; la finalitat, objectius, m&amp;egrave;tode i pla de treball, el programa de finan&amp;ccedil;ament, la composici&amp;oacute; i experi&amp;egrave;ncia de l’equip de treball, aix&amp;iacute; com dels llocs on es realitzar&amp;agrave;. El Patronat emetr&amp;agrave; informe sobre aquest projecte.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;b)&amp;nbsp;L’autoritzaci&amp;oacute; del projecte d’investigaci&amp;oacute; ser&amp;agrave; atorgada per l’administraci&amp;oacute; del Parc Nacional.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;c)&amp;nbsp;L’administraci&amp;oacute; del Parc Nacional podr&amp;agrave; concedir permisos especials per transitar fora dels camins autoritzats o per visitar les &amp;agrave;rees de protecci&amp;oacute; integral a persones o organismes cient&amp;iacute;fics que, estant interessats a realitzar estudis en el Parc Nacional, hagin presentat pr&amp;egrave;viament un programa de visita. En els permisos, que podran ser individuals o per grups, s’especificar&amp;agrave; el lloc per on poden transitar i amb quines condicions. Les activitats d’investigaci&amp;oacute; seran supervisades per la guarderia del Parc Nacional, que vetllar&amp;agrave; pel compliment de la normativa de protecci&amp;oacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;d)&amp;nbsp;L’administraci&amp;oacute; del Parc Nacional podr&amp;agrave; concedir permisos excepcionals d’acampada quan estigui justificada la perman&amp;egrave;ncia al Parc Nacional per a la realitzaci&amp;oacute; dels estudis. Els permisos especificaran el paratge perm&amp;egrave;s d’acampada, la durada i altres condicions que s’estimin oportunes. En el cas de grups d’investigaci&amp;oacute;, aquests seran el m&amp;eacute;s redu&amp;iuml;ts possible.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;e)&amp;nbsp;L’administraci&amp;oacute; del Parc podr&amp;agrave; sol·licitar de manera justificada informaci&amp;oacute; sobre els resultats que es van obtenint. En qualsevol cas, ser&amp;agrave; obligat&amp;ograve;ria la presentaci&amp;oacute; d’un informe anual sobre el desenvolupament de l’activitat.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;f)&amp;nbsp;L’administraci&amp;oacute; del Parc Nacional informar&amp;agrave; el Patronat de la finalitzaci&amp;oacute; del projecte i dels resultats obtinguts.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;g)&amp;nbsp;Els permisos d’investigaci&amp;oacute; podran ser retirats per l’administraci&amp;oacute; del Parc, per incompliment de la normativa aplicable o de les condicions establertes.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 23&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Senderisme&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;La pr&amp;agrave;ctica del senderisme es troba subjecta a les normes seg&amp;uuml;ents:&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;a)&amp;nbsp;No est&amp;agrave; perm&amp;egrave;s penetrar a les zones de reserva del Parc Nacional, o de reserva integral de la zona perif&amp;egrave;rica de protecci&amp;oacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;b)&amp;nbsp;A la resta del territori, nom&amp;eacute;s est&amp;agrave; perm&amp;egrave;s circular per camins, senders actualment existents.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;c)&amp;nbsp;Els itineraris guiats que s’efectu&amp;iuml;n a l’interior del Parc Nacional hauran de ser realitzats pels guies interpretadors acreditats pel Parc, llevat dels itineraris monogr&amp;agrave;fics realitzats per especialistes en el desenvolupament de funcions docents o de divulgaci&amp;oacute; de la investigaci&amp;oacute;, pr&amp;egrave;via autoritzaci&amp;oacute; de l’administraci&amp;oacute; del Parc, i les activitats alpin&amp;iacute;stiques o de travessia realitzades per guies de muntanya titulats. &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;d)&amp;nbsp;Les visites en grups organitzats de m&amp;eacute;s de vint persones hauran de dur-se a terme amb l’acompanyament dels guies interpretadors acreditats pel Parc Nacional. En el cas d’itineraris a peu per l’interior del Parc, caldr&amp;agrave; un guia interpretador per cada vint persones.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;e)&amp;nbsp;Si la pr&amp;agrave;ctica d’alguna de les activitats relacionades en els apartats anteriors pot representar un risc per a la conservaci&amp;oacute; dels sistemes naturals i la fauna, o un perill per a les persones, l’administraci&amp;oacute; del Parc Nacional podr&amp;agrave; limitar-les de forma temporal o indefinida. &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 24 &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Alpinisme, escalada i esqu&amp;iacute; i raquetes de neu&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;24.1&amp;nbsp;&amp;nbsp;S’ent&amp;eacute;n per alpinisme, a efectes del present Pla rector la realitzaci&amp;oacute; d’ascensions a pics elevats o dif&amp;iacute;cilment accessibles i les travessies d’alta muntanya per crestes o rutes sense camins marcats. S’ent&amp;eacute;n per escalada, l’alpinisme per a la realitzaci&amp;oacute; del qual &amp;eacute;s necessari disposar de mitjans artificials de subjecci&amp;oacute; i ancoratge a les roques.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;24.2&amp;nbsp;&amp;nbsp;Es poden dur a terme les activitats d’alpinisme, d’escalada i d’esqu&amp;iacute; de muntanya i raquetes de neu d’acord amb les normes seg&amp;uuml;ents:&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;a)&amp;nbsp;Es prohibeix la pr&amp;agrave;ctica de l’alpinisme, l’escalada i l’esqu&amp;iacute; de muntanya i raquetes de neu a les zones de reserva i de reserva integral.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;b)&amp;nbsp;L’esqu&amp;iacute; de muntanya i les raquetes de neu es realitzar&amp;agrave; per zones obertes i fons de vall, i s’evitaran les zones boscoses, excepte quan no hi hagi una via alternativa o hi hagi risc d’allaus. &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;c)&amp;nbsp;L’escalada s’ha de dur a terme per les vies existents d’acord amb l’inventari que les recull. No est&amp;agrave; permesa l’obertura de noves vies ni variants, sense autoritzaci&amp;oacute;. En tot cas, en l’obertura de noves vies s’evitar&amp;agrave; la proliferaci&amp;oacute; excessiva d’ancoratges fixes a la roca. &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;d)&amp;nbsp;Si la pr&amp;agrave;ctica d’alguna d’aquestes activitats pot representar un risc per a la conservaci&amp;oacute; dels sistemes naturals i la fauna, o un perill per a les persones, l’administraci&amp;oacute; del Parc Nacional podr&amp;agrave; limitar-les de forma temporal o indefinida tot donant la informaci&amp;oacute; necess&amp;agrave;ria. &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;f)&amp;nbsp;La pr&amp;agrave;ctica de surf de neu no est&amp;agrave; permesa.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 25&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Altres activitats recreatives&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;25.1&amp;nbsp;&amp;nbsp;Es prohibeixen les marxes a cavall i la circulaci&amp;oacute; de trineus en tot el territori del Parc Nacional. A la zona de protecci&amp;oacute; exterior, nom&amp;eacute;s estan permeses per les pistes i camins existents.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;25.2&amp;nbsp;&amp;nbsp;La circulaci&amp;oacute; de bicicletes queda circumscrita a la pista d’acc&amp;eacute;s d’Espot a l’Estany de Sant Maurici i a la pista que d&amp;oacute;na acc&amp;eacute;s des de la Palanca de La Molina al pla d’Aig&amp;uuml;estortes dins el Parc Nacional, i a les pistes per a vehicles de quatre rodes existents a la zona de protecci&amp;oacute; exterior.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;25.3&amp;nbsp;&amp;nbsp;No est&amp;agrave; permesa la circulaci&amp;oacute; amb motos de neu, quads de neu, o semblants.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;25.4&amp;nbsp;&amp;nbsp;Es prohibeix la pernoctaci&amp;oacute; fora dels refugis detallats a l’annex 2 d’aquest Pla, com tamb&amp;eacute; l’acampada i el bivac en tot el territori del Parc Nacional i zona perif&amp;egrave;rica de protecci&amp;oacute;, incloses les zones d’aparcament i, en general, d’&amp;uacute;s especial, a excepci&amp;oacute; de les zones habilitades per a tal fi a Estallos i Riumalo. Queden exemptes de la prohibici&amp;oacute; aquelles persones que disposin dels permisos especials d’estada justificats per estudis d’investigaci&amp;oacute;, gesti&amp;oacute; i control del medi natural.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;25.5&amp;nbsp;&amp;nbsp;Les entitats titulars dels refugis de muntanya hauran de disposar dels mitjans necessaris per a la depuraci&amp;oacute; de les aig&amp;uuml;es residuals que produeixin les seves instal·lacions i hauran d’assegurar l’evacuaci&amp;oacute; dels residus s&amp;ograve;lids que es generin als seus voltants.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;25.6&amp;nbsp;&amp;nbsp;No es poden construir nous refugis de muntanya. Els refugis existents poden ser adaptats i millorats. &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;25.7&amp;nbsp;&amp;nbsp;Est&amp;agrave; prohibit l’aterratge d’aeronaus i el sobrevol de l’espai aeri d’avionetes, velers, ultralleugers, helic&amp;ograve;pters i artefactes sense motor, com ara globus, ales delta, parapent i similars. S’exceptuen els casos d’emerg&amp;egrave;ncia i aquells justificats pel manteniment i subministrament dels refugis de muntanya, que podran dur-se a terme sota control de l’administraci&amp;oacute; del Parc Nacional.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;25.8&amp;nbsp;&amp;nbsp;Es prohibeixen les competicions esportives dins el Parc Nacional a excepci&amp;oacute; de les relacionades a l’annex 3, que podran ser autoritzades sota prohibici&amp;oacute; de sobrevol.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;25.9&amp;nbsp;&amp;nbsp;Queda prohibit portar a terme qualsevol de les activitats seg&amp;uuml;ents:&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;a)&amp;nbsp;Fer foc. Excepcionalment es podr&amp;agrave; autoritzar l’encesa de foc en els aplecs tradicionals de Sant Maurici i Sant Nicolau, previ informe de l’administraci&amp;oacute; del Parc i amb control de l’organisme competent. Tamb&amp;eacute; se n’exceptua la crema de restes generades en els aprofitaments agr&amp;iacute;coles i forestals tradicionals, a la zona de protecci&amp;oacute; exterior que es desenvoluparan d’acord amb la normativa vigent, previ informe de l’administraci&amp;oacute; del Parc. &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;b)&amp;nbsp;Arrencar o malmetre qualsevol element de senyalitzaci&amp;oacute; o mobiliari del Parc Nacional.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;c)&amp;nbsp;Banyar-se en estanys, rius i torrents, com tamb&amp;eacute; practicar qualsevol esport o activitat aqu&amp;agrave;tica o subaqu&amp;agrave;tica, incl&amp;ograve;s el descens de barrancs. &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;d)&amp;nbsp;Qualsevol estudi o activitat professional de fotografia, cinema o v&amp;iacute;deo amb finalitat comercial sense l’autoritzaci&amp;oacute; de l’administraci&amp;oacute; del Parc Nacional.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;e)&amp;nbsp;L’entrada d’animals dom&amp;egrave;stics de companyia, solts. S&amp;oacute;n animals de companyia els previstos a l’article 6 de la Llei 3/1988, de 4 de mar&amp;ccedil;, de protecci&amp;oacute; d’animals.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;f)&amp;nbsp;L’entrada de qualsevol animal dom&amp;egrave;stic distint dels previstos a l’apartat anterior i de la ramaderia sense autoritzaci&amp;oacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;g)&amp;nbsp;Llen&amp;ccedil;ar deixalles i abocar qualsevol mena de residus.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;h)&amp;nbsp;Qualsevol acci&amp;oacute; o omissi&amp;oacute; que vulneri les normes del present Pla.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 26&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Circulaci&amp;oacute;&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;26.1&amp;nbsp;&amp;nbsp;L’acc&amp;eacute;s al Parc Nacional &amp;uacute;nicament est&amp;agrave; perm&amp;egrave;s a peu o amb transport p&amp;uacute;blic autoritzat.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;26.2&amp;nbsp;&amp;nbsp;Tindran regulaci&amp;oacute; espec&amp;iacute;fica dictada pel Patronat, a proposta de l’administraci&amp;oacute; del Parc Nacional els vehicles seg&amp;uuml;ents:&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;a)&amp;nbsp;Els vehicles de servei oficial al Parc Nacional.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;b)&amp;nbsp;Els vehicles de servei del transport p&amp;uacute;blic.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;c)&amp;nbsp;Els vehicles de servei necessaris per al control de les activitats autoritzades i el manteniment de les instal·lacions existents a l’interior del Parc com ara pastos, refugis excursionistes i infraestructures hidroel&amp;egrave;ctriques.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;d)&amp;nbsp;Els vehicles de les persones propiet&amp;agrave;ries de terrenys a l’interior del Parc Nacional, &amp;uacute;nicament per a l’acc&amp;eacute;s a les seves finques i la maquin&amp;agrave;ria agr&amp;iacute;cola d’aquestes persones &amp;uacute;nicament per a les activitats permeses.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;e)&amp;nbsp;Els vehicles del ve&amp;iuml;natge domiciliat als municipis d’Espot i la Vall de Bo&amp;iacute;. Els ajuntaments, d’acord amb les ordenances, hauran de definir quins ve&amp;iuml;ns i ve&amp;iuml;nes podran accedir a l’&amp;agrave;mbit de l’espai protegit corresponent al seu terme municipal.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;26.3&amp;nbsp;&amp;nbsp;Els vehicles de transport p&amp;uacute;blic no podran sobrepassar els 30 km/hora en la seva circulaci&amp;oacute; per les pistes autoritzades dins el Parc Nacional i zona perif&amp;egrave;rica de protecci&amp;oacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;26.4&amp;nbsp;&amp;nbsp;L’acc&amp;eacute;s al Parc dels vehicles de les persones propiet&amp;agrave;ries de terrenys i del ve&amp;iuml;natge domiciliat als municipis d’Espot i de Vall de Bo&amp;iacute;, aix&amp;iacute; com dels vehicles de servei p&amp;uacute;blic de transport discrecional de viatgers fins a 9 places, incloent-hi la prestaci&amp;oacute; de serveis d’aquests &amp;uacute;ltims, es regular&amp;agrave; per les Ordres de 17 de desembre de 1993 i 46/2002, de 19 de febrer, per la qual es regulen determinats aspectes de la prestaci&amp;oacute; del servei p&amp;uacute;blic de transport discrecional de persones amb vehicles de fins a nou places, al Parc Nacional d’Aig&amp;uuml;estortes i Estany de Sant Maurici&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;26.5&amp;nbsp;&amp;nbsp;La circulaci&amp;oacute; dels vehicles de transport p&amp;uacute;blic autoritzats a entrar al Parc es limitar&amp;agrave; a la zona d’&amp;uacute;s especial. En casos excepcionals i justificats, l’administraci&amp;oacute; del Parc podr&amp;agrave; atorgar permisos especials per a la circulaci&amp;oacute; de vehicles a l’interior del Parc Nacional.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;26.6&amp;nbsp;&amp;nbsp;No es permet la circulaci&amp;oacute; de vehicles de m&amp;eacute;s de dos metres d’amplada per les carreteres d’acc&amp;eacute;s al Parc Nacional. S’exceptuen els vehicles autoritzats per a feines agr&amp;iacute;coles i ramaderes, tasques de manteniment i d’emerg&amp;egrave;ncies. &lt;/P&gt;&#13;&#10;&lt;P&gt;Cap&amp;iacute;tol V&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;R&amp;egrave;gim d’usos i aprofitaments &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 27&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Territori del Parc Nacional&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Els usos i activitats permeses en les diferents zones del Parc Nacional s&amp;oacute;n les seg&amp;uuml;ents:&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;a)&amp;nbsp;Zona d’&amp;uacute;s especial.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Es consideren usos admissibles les activitats de car&amp;agrave;cter recreatiu, interpretatiu, educatiu i de servei per al control i manteniment del medi. De manera general, l’acc&amp;eacute;s p&amp;uacute;blic &amp;eacute;s lliure. Es consideren activitats recreatives, a efectes d’aquest Pla, les establertes als articles 23 a 25.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;b)&amp;nbsp;Zona d’&amp;uacute;s moderat.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Es consideren usos admissibles les activitats amb finalitats recreatives, educatives, d’interpretaci&amp;oacute; de la natura, cient&amp;iacute;fiques i de control del medi.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;No est&amp;agrave; perm&amp;egrave;s cap altre &amp;uacute;s, ni cap tipus d’aprofitament, excepte el tradicional de la pastura i l’hidroel&amp;egrave;ctric existent.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;c)&amp;nbsp;Zona d’&amp;uacute;s restringit.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Aquestes &amp;agrave;rees queden sotmeses a un r&amp;egrave;gim integral de protecci&amp;oacute;, i nom&amp;eacute;s estaran permeses, les activitats amb finalitat educativa, d’interpretaci&amp;oacute; de la natura, recreatives, cient&amp;iacute;fica, alpin&amp;iacute;stica i de control del medi, degudament controlades.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Queda prohibida qualsevol acci&amp;oacute; i intervenci&amp;oacute; que pugui suposar una transformaci&amp;oacute; o modificaci&amp;oacute; del medi i comporti degradaci&amp;oacute; dels ecosistemes. No s’admetr&amp;agrave; cap tipus d’aprofitament, excepte el tradicional de la pastura i el manteniment d’infraestructures d’&amp;uacute;s p&amp;uacute;blic.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;d)&amp;nbsp;Zona de reserva.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;No es permet cap activitat en aquestes zones, incl&amp;ograve;s l’acc&amp;eacute;s, donats els objectius de protecci&amp;oacute; estricta que motiven la seva catalogaci&amp;oacute;. Nom&amp;eacute;s podran ser autoritzades per l’administraci&amp;oacute; del Parc les actuacions relatives a investigaci&amp;oacute; cient&amp;iacute;fica, i en general aquelles actuacions necess&amp;agrave;ries per garantir la conservaci&amp;oacute; o equilibri de la zona.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 28&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Territori de la zona perif&amp;egrave;rica de protecci&amp;oacute;&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;En el territori de la zona perif&amp;egrave;rica de protecci&amp;oacute; del Parc Nacional s’estableixen les seg&amp;uuml;ents normes per a les zones previstes a l’article 17 del present Pla:&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;a)&amp;nbsp;Zona perif&amp;egrave;rica d’&amp;uacute;s especial.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Es consideren usos admissibles, de manera general, les activitats de car&amp;agrave;cter recreatiu, educatiu, de servei per al control i manteniment del medi i d’acc&amp;eacute;s als aprofitaments compatibles amb la conservaci&amp;oacute; de l’espai protegit. El tr&amp;agrave;nsit &amp;eacute;s lliure, tant de vianants com en vehicle.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;b)&amp;nbsp;Zona de protecci&amp;oacute; exterior del Parc Nacional.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;D’acord amb l’article 4.2 de la Llei 7/1988, nom&amp;eacute;s es permeten en aquesta zona els usos i aprofitaments tradicionals compatibles amb les finalitats de protecci&amp;oacute; i conservaci&amp;oacute; del medi. Qualsevol aprofitament, obra o activitat nova ha de ser pr&amp;egrave;viament autoritzada per l’administraci&amp;oacute; del Parc, que haur&amp;agrave; de sol·licitar informe al Patronat del Parc Nacional.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;c)&amp;nbsp;Zona d’especial inter&amp;egrave;s ecol&amp;ograve;gic i paisatg&amp;iacute;stic.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Es consideren usos admissibles les activitats amb finalitat educativa, recreativa, cient&amp;iacute;fica, alpin&amp;iacute;stica, de control del medi i el pasturatge tradicional.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Queda prohibida qualsevol acci&amp;oacute; i intervenci&amp;oacute; que pugui suposar la degradaci&amp;oacute; dels ecosistemes. No s’admetr&amp;agrave; cap tipus d’aprofitament, excepte el tradicional de la pastura, la ca&amp;ccedil;a i pesca, mentre no s’elabori un programa espec&amp;iacute;fic d’ordenaci&amp;oacute; dels usos i aprofitaments tradicionals que garanteixi la conservaci&amp;oacute; dels valors naturals d’aquestes zones. Aquests programes, que han de garantir la conservaci&amp;oacute; dels valors dels espais, seran elaborats en el termini de dos anys des de l’aprovaci&amp;oacute; definitiva del Pla rector d’&amp;uacute;s i gesti&amp;oacute;, per la direcci&amp;oacute; General de Boscos i Biodiversitat i es tramitaran d’acord amb el que estableix la Llei 7/1988, de 30 de mar&amp;ccedil;, de reclassificaci&amp;oacute; del Parc Nacional d’Aig&amp;uuml;estortes Estany de Sant Maurici. Mentre no s’aprovin aquests programes, la direcci&amp;oacute; del Parc podr&amp;agrave; establir, amb car&amp;agrave;cter excepcional, limitacions dels usos i aprofitaments tradicionals gen&amp;egrave;ricament admesos a la zona perif&amp;egrave;rica de protecci&amp;oacute;, amb el pagament si s’escau, de la corresponent indemnitzaci&amp;oacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;d)&amp;nbsp;Zona de reserva integral.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Queda prohibida qualsevol acci&amp;oacute; i intervenci&amp;oacute; que pugui suposar una transformaci&amp;oacute; o modificaci&amp;oacute; del medi i comporti degradaci&amp;oacute; dels ecosistemes. No s’admet cap tipus d’aprofitament, incl&amp;ograve;s el tradicional de la pastura.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 29&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Activitats incompatibles &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;En l’&amp;agrave;mbit del Parc Nacional queden prohibides, d’acord amb el que estableix l’article 3.1 de la Llei 7/1988, de 30 de mar&amp;ccedil;, de reclassificaci&amp;oacute; del Parc Nacional d’Aig&amp;uuml;estortes i Estany de Sant Maurici, les seg&amp;uuml;ents activitats:&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;a)&amp;nbsp;La construcci&amp;oacute; de carreteres, autopistes, autovies, funiculars, remuntadors mec&amp;agrave;nics, telef&amp;egrave;rics i l&amp;iacute;nies ferrovi&amp;agrave;ries.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;b)&amp;nbsp;L’autoritzaci&amp;oacute; de construcci&amp;oacute; d’estacions i pistes d’esqu&amp;iacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;c)&amp;nbsp;Les instal·lacions de tractament fisicoqu&amp;iacute;mic, incineraci&amp;oacute; o altres sistemes de tractament de residus perillosos o sanitaris.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;d)&amp;nbsp;Abocar, enterrar o incinerar qualsevol tipus de residu. Els residus que es generin es traslladaran a l’exterior del Parc, a les instal·lacions de tractament de residus.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;e)&amp;nbsp;La introducci&amp;oacute; i l’alliberament de subst&amp;agrave;ncies qu&amp;iacute;miques o biol&amp;ograve;giques actives de qualsevol tipus. S’exceptuen aquelles que siguin necess&amp;agrave;ries per al maneig i control dels recursos del Parc i que hagi d’utilitzar l’Administraci&amp;oacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;f)&amp;nbsp;L’entrada al territori del Parc Nacional amb armes de qualsevol tipus, excepte les que portin els agents de l’autoritat i els guardes. &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 30&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Usos i aprofitaments&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;30.1&amp;nbsp;&amp;nbsp;En l’&amp;agrave;mbit del Parc Nacional queden prohibits els seg&amp;uuml;ents usos i aprofitaments:&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;a)&amp;nbsp;L’&amp;uacute;s d’adobs qu&amp;iacute;mics i la sembra amb esp&amp;egrave;cies que no siguin aut&amp;ograve;ctones de la zona es regir&amp;agrave; pel que preveu el Reial decret 1803/1999.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;b)&amp;nbsp;La pastura a la zona de reserva del Parc Nacional, i en les &amp;agrave;rees de reserva integral de la zona perif&amp;egrave;rica de protecci&amp;oacute;. En la resta del territori, la pastura, com a activitat tradicional de la zona, est&amp;agrave; adm&amp;egrave;s.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;30.2&amp;nbsp;&amp;nbsp;Nom&amp;eacute;s es podran realitzar accions dirigides a la repoblaci&amp;oacute; o al tractament silv&amp;iacute;cola en casos excepcionals d’incendis i plagues. A la zona de protecci&amp;oacute; exterior est&amp;agrave; perm&amp;egrave;s l’aprofitament forestal que estigui sotm&amp;egrave;s a plans d’ordenaci&amp;oacute; aprovats per l’Administraci&amp;oacute;; a l’efecte, pr&amp;egrave;viament a la seva aprovaci&amp;oacute;, el Patronat i l’&amp;ograve;rgan gestor del Parc Nacional hauran d’emetre informe preceptiu.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;30.3&amp;nbsp;&amp;nbsp;A la zona de protecci&amp;oacute; exterior, els plans t&amp;egrave;cnics de gesti&amp;oacute; cineg&amp;egrave;tica de la Reserva Nacional de Ca&amp;ccedil;a de l’Alt Pallars-Aran, de la zona de ca&amp;ccedil;a controlada de la Val d’Aran i de les &amp;agrave;rees privades de ca&amp;ccedil;a existents, tindran en compte la funci&amp;oacute; protectora del Parc que desenvolupa aquesta zona de protecci&amp;oacute; exterior. Pr&amp;egrave;viament a l’aprovaci&amp;oacute; dels esmentats plans t&amp;egrave;cnics de gesti&amp;oacute; cineg&amp;egrave;tica, el Patronat i l’&amp;ograve;rgan gestor del Parc Nacional hauran d’emetre informe preceptiu.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;30.4&amp;nbsp;&amp;nbsp;A la zona de protecci&amp;oacute; exterior, els plans t&amp;egrave;cnics de gesti&amp;oacute; pisc&amp;iacute;cola de les zones de pesca controlada existents, tindran en compte la funci&amp;oacute; protectora del Parc que desenvolupa aquesta zona de protecci&amp;oacute; exterior. Pr&amp;egrave;viament a l’aprovaci&amp;oacute; dels esmentats plans t&amp;egrave;cnics, el Patronat i l’&amp;ograve;rgan gestor del Parc Nacional hauran d’emetre informe preceptiu.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;30.5&amp;nbsp;&amp;nbsp;Per a les zones d’especial inter&amp;egrave;s ecol&amp;ograve;gic i paisatg&amp;iacute;stic s’elaborar&amp;agrave; un programa espec&amp;iacute;fic d’ordenaci&amp;oacute; dels usos i aprofitaments tradicionals, aix&amp;iacute; com de la ca&amp;ccedil;a i la pesca.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 31&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;R&amp;egrave;gim de les infraestructures, instal·lacions i habitatges&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;31.1&amp;nbsp;&amp;nbsp;En l’&amp;agrave;mbit del Parc Nacional queden prohibides, d’acord amb el que estableix l’article 3.1 de la Llei 7/1988, de 30 de mar&amp;ccedil;, de reclassificaci&amp;oacute; del Parc Nacional d’Aig&amp;uuml;estortes i Estany de Sant Maurici, les seg&amp;uuml;ents actuacions relatives a infraestructures, instal·lacions i habitatges:&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;a)&amp;nbsp;La instal·laci&amp;oacute; de noves l&amp;iacute;nies el&amp;egrave;ctriques i telef&amp;ograve;niques.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;b)&amp;nbsp;La consolidaci&amp;oacute; de noves traces de pistes dins el Parc Nacional, a excepci&amp;oacute; de la zona d’&amp;uacute;s especial. A la zona perif&amp;egrave;rica de protecci&amp;oacute; es podran consolidar les noves traces de les pistes considerades en els plans d’ordenaci&amp;oacute; forestal aprovats.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;c)&amp;nbsp;La consolidaci&amp;oacute; de cap nova tra&amp;ccedil;a de camins i sendes que no sigui mitjan&amp;ccedil;ant la compactaci&amp;oacute; del terreny natural. L’ampl&amp;agrave;ria actual de la tra&amp;ccedil;a en totes les sendes i rutes d’itineraris no podr&amp;agrave; ser ampliada.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;d)&amp;nbsp;La construcci&amp;oacute; d’edificacions de nova planta de qualsevol tipus, a excepci&amp;oacute; de les estructures que siguin necess&amp;agrave;ries per garantir la conservaci&amp;oacute; del Parc, o posseeixin una utilitat p&amp;uacute;blica o inter&amp;egrave;s social, que podran ser autoritzades en les condicions establertes en l’article 3.1 i 4.2 de la Llei 7/1988.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;31.2&amp;nbsp;&amp;nbsp;Qualsevol obra de millora o condicionament d’infraestructures haur&amp;agrave; de tenir una autoritzaci&amp;oacute; de l’administraci&amp;oacute; del Parc Nacional, que emetr&amp;agrave; un informe preceptiu sobre el projecte t&amp;egrave;cnic. Ser&amp;agrave; obligatori el dip&amp;ograve;sit de la fian&amp;ccedil;a del 4% dels pressupostos, amb un m&amp;iacute;nim de 1.502 euros. En el cas d’arranjament dels camins propietat de les empreses hidroel&amp;egrave;ctriques, les obres hauran d’adequar-se a la normativa relativa a infraestructures establerta en aquest Decret. La documentaci&amp;oacute; m&amp;iacute;nima d’aquests projectes contindr&amp;agrave; una mem&amp;ograve;ria, plans, avaluaci&amp;oacute; d’efectes en el medi natural, estudi de restauraci&amp;oacute; i condicionament, plec de condicions i pressupost.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;31.3&amp;nbsp;&amp;nbsp;Les obres de millora i condicionament hauran de dur-se a terme fora de les &amp;egrave;poques de m&amp;agrave;xima aflu&amp;egrave;ncia de visitants i sense causar mol&amp;egrave;sties a la fauna protegida en la seva &amp;egrave;poca de reproducci&amp;oacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;31.4&amp;nbsp;&amp;nbsp;D’acord amb el que estableixen l’article 29.2 de la Llei 12/1985, de 13 de juny, d’espais naturals, i l’article 9.3 de la Llei 7/1988, de 30 de mar&amp;ccedil;, de reclassificaci&amp;oacute; del Parc Nacional d’Aig&amp;uuml;estortes i Estany de Sant Maurici, l’administraci&amp;oacute; del Parc Nacional i el Patronat han d’emetre informe preceptiu previ a l’atorgament de les autoritzacions necess&amp;agrave;ries per a l’execuci&amp;oacute; de qualsevol pla, obra, moviment de terres o explotaci&amp;oacute; dels recursos naturals que afectin el territori del Parc Nacional i la seva zona perif&amp;egrave;rica de protecci&amp;oacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 32&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;R&amp;egrave;gim d’aprofitaments lligats a l’activitat comercial&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;32.1&amp;nbsp;&amp;nbsp;En l’&amp;agrave;mbit del Parc Nacional queden prohibides les seg&amp;uuml;ents activitats lligades a l’activitat comercial:&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;a)&amp;nbsp;La venda ambulant.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;b)&amp;nbsp;La publicitat i la propaganda, excepte en els casos de patrocini d’actuacions considerades en el Pla rector d’&amp;uacute;s i gesti&amp;oacute; o en plans de conservaci&amp;oacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;32.2&amp;nbsp;&amp;nbsp;L’administraci&amp;oacute; del Parc &amp;eacute;s propiet&amp;agrave;ria exclusiva de les expressions &amp;quot;Parc Nacional d’Aig&amp;uuml;estortes i Estany de Sant Maurici&amp;quot;, &amp;quot;Parque Nacional de Aig&amp;uuml;estortes i Estany de Sant Maurici&amp;quot;, o qualsevol expressi&amp;oacute; constitu&amp;iuml;da amb &amp;quot;Parque Nacional&amp;quot;, o &amp;quot;Parc Nacional&amp;quot;. No es permet, sense la seva autoritzaci&amp;oacute;, qualsevol tipus d’utilitzaci&amp;oacute; comercial d’aquestes expressions.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 33 &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Activitats d’&amp;uacute;s p&amp;uacute;blic &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Aquelles activitats destinades a l’&amp;uacute;s p&amp;uacute;blic gestionades per tercers, seran regulades per l’administraci&amp;oacute; del Parc, que assegurar&amp;agrave; el seu control i adequaci&amp;oacute; al sistema d’&amp;uacute;s p&amp;uacute;blic del Parc Nacional.&lt;/P&gt;&#13;&#10;&lt;P&gt;Cap&amp;iacute;tol VI&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Administraci&amp;oacute; i funcionament &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 34&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Director/a-conservador/a&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;34.1&amp;nbsp;&amp;nbsp;La responsabilitat de l’administraci&amp;oacute; del Parc Nacional correspon a un director/a-conservador/a nomenat pel Govern de la Generalitat, a proposta del conseller/a de Medi Ambient, d’acord amb el previst a l’article 4 de la Llei 22/1990.&amp;nbsp;Aquest c&amp;agrave;rrec ha de recaure en una persona amb titulaci&amp;oacute; universit&amp;agrave;ria superior id&amp;ograve;nia.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;34.2&amp;nbsp;&amp;nbsp;Correspon al director/a-conservador/a:&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;a)&amp;nbsp;Executar els acords del Ple i la Comissi&amp;oacute; Permanent del Patronat.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;b)&amp;nbsp;Supervisar, controlar i coordinar les actuacions que es desenvolupin en el Parc Nacional i Zona Perif&amp;egrave;rica de Protecci&amp;oacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;c)&amp;nbsp;Regir l’activitat de les Unitats funcionals integrades en l’&amp;ograve;rgan gestor del Parc Nacional.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;d)&amp;nbsp;Les relacions exteriors i de representaci&amp;oacute; del Parc Nacional.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;e)&amp;nbsp;Convocar, en nom de la presid&amp;egrave;ncia, les reunions del Ple i de la Comissi&amp;oacute; Permanent del Patronat.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;f)&amp;nbsp;Redactar les actes de les sessions dels &amp;ograve;rgans del Patronat i la Comissi&amp;oacute; de Coordinaci&amp;oacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;g)&amp;nbsp;Redactar i proposar a la consideraci&amp;oacute; del Ple del Patronat la mem&amp;ograve;ria anual d’activitats i resultats.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;h)&amp;nbsp;Informar el Ple i la Comissi&amp;oacute; Permanent del Patronat de les gestions realitzades des de les &amp;uacute;ltimes sessions d’ambd&amp;oacute;s &amp;ograve;rgans.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;i)&amp;nbsp;Adoptar, en cas d’emerg&amp;egrave;ncia, les mesures d’urg&amp;egrave;ncia necess&amp;agrave;ries i informar-ne la presid&amp;egrave;ncia del Patronat.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;j)&amp;nbsp;Convocar, en nom de la presid&amp;egrave;ncia, les reunions de la Comissi&amp;oacute; de Coordinaci&amp;oacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;k)&amp;nbsp;Qualsevol altre treball que li encarregui el Patronat o el Departament de Medi Ambient.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 35&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Unitats funcionals&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;35.1&amp;nbsp;&amp;nbsp;L’equip de gesti&amp;oacute; del Parc Nacional s’estructura en les unitats seg&amp;uuml;ents:&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;a)&amp;nbsp;Unitat d’Administraci&amp;oacute; i Gesti&amp;oacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;b)&amp;nbsp;Unitat de Medi Natural.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;c)&amp;nbsp;Unitat de Vigil&amp;agrave;ncia.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;d)&amp;nbsp;Unitat d’&amp;Uacute;s P&amp;uacute;blic.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;e)&amp;nbsp;Unitat d’Investigaci&amp;oacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;35.2&amp;nbsp;&amp;nbsp;La Direcci&amp;oacute; General de Boscos i Biodiversitat i Direcci&amp;oacute; General de Prevenci&amp;oacute; de Riscos del Medi Natural del Departament de Medi Ambient dotaran les unitats funcionals de la capacitat operativa necess&amp;agrave;ria per al desenvolupament de les seves funcions i proposar&amp;agrave; les persones responsables i el personal.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 36&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Unitat d’Administraci&amp;oacute; i Gesti&amp;oacute;&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Les funcions de la Unitat d’Administraci&amp;oacute; i Gesti&amp;oacute; s&amp;oacute;n les seg&amp;uuml;ents:&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;a)&amp;nbsp;Tramitar administrativament els expedients de funcionament, inversions i subvencions.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;b)&amp;nbsp;Elaborar els comptes de gesti&amp;oacute; econ&amp;ograve;mica la justificaci&amp;oacute; d’ingressos i despeses i les ordres de pagaments del r&amp;egrave;gim d’autonomia econ&amp;ograve;mica.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;c)&amp;nbsp;Preparar la proposta anual de pressupostos i controlar-ne la correcta execuci&amp;oacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;d)&amp;nbsp;Elaborar propostes per al desenvolupament i promoci&amp;oacute; del Parc Nacional i del seu entorn.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;e)&amp;nbsp;Buscar nous sistemes de finan&amp;ccedil;ament del Parc Nacional.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;f)&amp;nbsp;Dur a terme les tasques de manteniment de l’inventari.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;g)&amp;nbsp;Intervenir en els treballs administratius dels programes de desenvolupament del Pla rector d’&amp;uacute;s i gesti&amp;oacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;h)&amp;nbsp;Establir col·laboracions amb administracions p&amp;uacute;bliques i entitats privades, i contactes permanents amb els ajuntaments i consells comarcals.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;i)&amp;nbsp;Coordinar i impulsar les publicacions pr&amp;ograve;pies.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;j)&amp;nbsp;Establir contactes amb els mitjans de comunicaci&amp;oacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;k)&amp;nbsp;Donar suport a la direcci&amp;oacute; en les relacions amb l’entorn.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;l)&amp;nbsp;Dur a terme la secretaria de la direcci&amp;oacute; del Parc, Patronat i comissions.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;m)&amp;nbsp;Dur a terme la gesti&amp;oacute; del personal adscrit.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;n)&amp;nbsp;Fer el seguiment de les concessions i cessions administratives.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;o)&amp;nbsp;Portar el registre d’entrada i sortida de la correspond&amp;egrave;ncia.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;p)&amp;nbsp;Dur a terme les gestions d’autoritzaci&amp;oacute; d’activitats especials, extraordin&amp;agrave;ries, tradicionals i permisos.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 37&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Unitat de Medi Natural&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Les funcions de la Unitat de Medi Natural s&amp;oacute;n les seg&amp;uuml;ents:&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;a)&amp;nbsp;Redactar projectes t&amp;egrave;cnics.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;b)&amp;nbsp;Gestionar els sistemes naturals.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;c)&amp;nbsp;Fer el seguiment i control peri&amp;ograve;dic de les poblacions animals i vegetals i dels agents f&amp;iacute;sics.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;d)&amp;nbsp;Fer el seguiment dels programes de desenvolupament del Pla rector d’&amp;uacute;s i gesti&amp;oacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;e)&amp;nbsp;Elaborar els programes sectorials d’emerg&amp;egrave;ncia.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;f)&amp;nbsp;Coordinar les actuacions de vigil&amp;agrave;ncia i de manteniment.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;g)&amp;nbsp;Revisar les assist&amp;egrave;ncies t&amp;egrave;cniques en la planificaci&amp;oacute; i gesti&amp;oacute; de recursos.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;h)&amp;nbsp;Fer el seguiment dels riscos naturals.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;i)&amp;nbsp;Planificar, executar i avaluar les activitats i els estudis en mat&amp;egrave;ria d’obres i manteniment.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;j)&amp;nbsp;Realitzar el manteniment d’infraestructures, vehicles, material de comunicacions i immobles.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;k)&amp;nbsp;Dur a terme el manteniment dels ecosistemes del Parc.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 38&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Unitat de Vigil&amp;agrave;ncia&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Les funcions de la Unitat de Vigil&amp;agrave;ncia s&amp;oacute;n les seg&amp;uuml;ents:&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;a)&amp;nbsp;Seguiment de l’estat de conservaci&amp;oacute; de les estructures del Parc.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;b)&amp;nbsp;Vigil&amp;agrave;ncia i control de les activitats realitzades al Parc.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;c)&amp;nbsp;Actuacions d’emerg&amp;egrave;ncia.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;d)&amp;nbsp;Vigil&amp;agrave;ncia del compliment de la normativa del Parc.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;e)&amp;nbsp;Seguiment de les variables naturals i ecol&amp;ograve;giques del Parc.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 39&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Unitat d’&amp;Uacute;s P&amp;uacute;blic&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Les funcions de la Unitat d’&amp;Uacute;s P&amp;uacute;blic s&amp;oacute;n les seg&amp;uuml;ents: &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;a)&amp;nbsp;Elaborar i fer el seguiment dels temes d’interpretaci&amp;oacute; del medi natural.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;b)&amp;nbsp;Desenvolupar i fer el seguiment de programes educatius i de divulgaci&amp;oacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;c)&amp;nbsp;Preparar les exposicions permanents i els itineraris.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;d)&amp;nbsp;Distribuir el material de divulgaci&amp;oacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;e)&amp;nbsp;Controlar el nombre de visitants del Parc Nacional i la seva distribuci&amp;oacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;f)&amp;nbsp;Coordinar el servei d’atenci&amp;oacute; al p&amp;uacute;blic dels diferents equipaments.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;g)&amp;nbsp;Coordinar les relacions amb el transport p&amp;uacute;blic del Parc Nacional.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;h)&amp;nbsp;Dissenyar, desenvolupar i coordinar els programes de voluntariat i estada en pr&amp;agrave;ctiques.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;i)&amp;nbsp;Coordinar l’intercanvi de material divulgatiu amb altres espais protegits.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 40&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Unitat d’Investigaci&amp;oacute;, estudis i documentaci&amp;oacute;&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Les funcions de la Unitat d’investigaci&amp;oacute;, estudis i documentaci&amp;oacute; s&amp;oacute;n les seg&amp;uuml;ents:&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;a)&amp;nbsp;Fer l’inventari exhaustiu i la prospecci&amp;oacute; sistem&amp;agrave;tica i met&amp;ograve;dica dels ecosistemes del Parc Nacional i zona perif&amp;egrave;rica de protecci&amp;oacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;b)&amp;nbsp;Promocionar estudis generals i espec&amp;iacute;fics, i alhora dirigir i verificar-ne la correcta execuci&amp;oacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;c)&amp;nbsp;Crear un fons documental i bibliogr&amp;agrave;fic.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;d)&amp;nbsp;Crear un banc de dades biol&amp;ograve;giques i ecol&amp;ograve;giques.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;e)&amp;nbsp;Coordinar relacions d’intercanvi cient&amp;iacute;fic amb altres espais protegits.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;f)&amp;nbsp;Col·laborar amb grups i programes d’investigaci&amp;oacute; centrats en l’estudi del Parc Nacional.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Article 41&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Perspectiva de g&amp;egrave;nere&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Es contemplar&amp;agrave; la participaci&amp;oacute; activa de la dona en la presa de decisions relatives a l’assoliment de les finalitats i els objectius del present Pla en tots els nivells, des de la definici&amp;oacute; de programes i projectes, fins la seva execuci&amp;oacute; i avaluaci&amp;oacute; &lt;/P&gt;&#13;&#10;&lt;P&gt;Annex 1&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Zonificaci&amp;oacute; &lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;La zonificaci&amp;oacute; del Parc Nacional ve reflectida en el mapa corresponent, on es delimiten les zones seg&amp;uuml;ents:&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;a)&amp;nbsp;Territori del Parc Nacional.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Zona de reserva.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;1.&amp;nbsp;Estany de Trescuro.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;2.&amp;nbsp;Bony del Graller.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Zona d’&amp;uacute;s restringit.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt; 3.&amp;nbsp;Ribera de Llacs, i valls de Morrano i Dellui.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;4.&amp;nbsp;Obaga de Sant Nicolau.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;5.&amp;nbsp;Vall de Subenuix.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;6.&amp;nbsp;Vall de Monestero.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;7.&amp;nbsp;Els Encantats.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;8.&amp;nbsp;Estany Negre de Peguera.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;9.&amp;nbsp;Estanys Gelats.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;10.&amp;nbsp;Obaga de la S. de Mart&amp;iacute; Llac.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;11.&amp;nbsp;Vall de Sant Nicolau.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;12.&amp;nbsp;Vall de l’Escrita.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;13.&amp;nbsp;Vall de Ratera.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;14.&amp;nbsp;Estanys Escondits i del Cap del Port.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;15.&amp;nbsp;Capceres de Caldes.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Zona d’&amp;uacute;s moderat.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;16.&amp;nbsp;Presa de Sant Esperit i voltants.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;17.&amp;nbsp;Presa de Sant Maurici i voltants, incl&amp;ograve;s el refugi de Mallafr&amp;eacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;18.&amp;nbsp;Presa de Tort i voltants, incl&amp;ograve;s el refugi de J. Mar&amp;iacute;a Blanc.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;19.&amp;nbsp;Presa d’Amitges i voltants, incl&amp;ograve;s el refugi d’Amitges.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;20.&amp;nbsp;Refugi d’Estany Llong.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;21.&amp;nbsp;Refugi de la Centraleta.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;22.&amp;nbsp;Refugi de Ventosa i Calvell.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;23.&amp;nbsp;Senda per a l’itinerari de Palanca de la Molina-Portarr&amp;oacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;24.&amp;nbsp;Senda per a l’itinerari de P. Aig&amp;uuml;estortes-Dellu&amp;iacute;-P.Gran.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;25.&amp;nbsp;Senda per a l’itinerari de Prat de Pierr&amp;oacute;-Sant Maurici-Portarr&amp;oacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;26.&amp;nbsp;Senda per a l’itinerari cap a l’estany Negre de Peguera.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Zona d’&amp;uacute;s especial.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;27.&amp;nbsp;Trams d’acc&amp;eacute;s rodat del transport p&amp;uacute;blic a la vall de Sant Nicolau.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;28.&amp;nbsp;Trams d’acc&amp;eacute;s rodat del transport p&amp;uacute;blic a la vall de l’Escrita.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;29.&amp;nbsp;Trams d’acc&amp;eacute;s rodat del transport p&amp;uacute;blic a la vall de Ratera.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;30.&amp;nbsp;Trams d’acc&amp;eacute;s rodat del transport p&amp;uacute;blic al bosc de Riufred.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;b)&amp;nbsp;Territori de la zona perif&amp;egrave;rica de protecci&amp;oacute;.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Zona de reserva integral.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt; 31.&amp;nbsp;Torberes i prats humits d’Aiguam&amp;ograve;g.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;Zona d’especial inter&amp;egrave;s ecol&amp;ograve;gic i paisatg&amp;iacute;stic.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;32.&amp;nbsp;Obaga de l’Escrita i Carbonero.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;33.&amp;nbsp;Obaga de la Mata de Val&amp;egrave;ncia.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;34.&amp;nbsp;Valls de Gerber i Cabanes.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;35.&amp;nbsp;Ribera d’Aiguam&amp;ograve;g.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&quot;&gt;36.&amp;nbsp;Serra de Rei.&lt;/P&gt;&#13;&#10;&lt;P ALIGN=&quot;JUSTIFY&