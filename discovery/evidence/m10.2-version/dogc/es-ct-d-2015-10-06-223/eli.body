<?xml version="1.0" encoding="UTF-8" standalone="no"?><akomaNtoso xmlns="http://docs.oasis-open.org/legaldocml/ns/akn/3.0" xmlns:eadop="https://portaljuridic.gencat.cat/eli-eadop#" xmlns:eadopakm="https://portaljuridic.gencat.cat/akm-eadop"><act contains="singleVersion" name="10"><meta><identification><FRBRWork><FRBRthis value="https://portaljuridic.gencat.cat/eli/es-ct/d/2015/10/06/223"/><FRBRuri value="https://portaljuridic.gencat.cat/eli/es-ct/d/2015/10/06/223"/><FRBRdate date="2015-10-15" name="Generation"/><FRBRauthor as="Author" href="Departament d'Empresa i Ocupació"/><FRBRcountry value="ES"/></FRBRWork><FRBRExpression><FRBRthis value="https://portaljuridic.gencat.cat/eli/es-ct/d/2015/10/06/223/dof"/><FRBRuri value="https://portaljuridic.gencat.cat/eli/es-ct/d/2015/10/06/223/dof"/><FRBRdate date="2020-05-01" name="Markup"/><FRBRlanguage language="CA"/></FRBRExpression><FRBRManifestation><FRBRthis value="https://portaljuridic.gencat.cat/eli/es-ct/d/2015/10/06/223/con/20200501/cat/xml"/><FRBRuri value="https://portaljuridic.gencat.cat/eli/es-ct/d/2015/10/06/223/con/20200501/cat/xml"/><FRBRdate date="2020-05-01" name="AKN_convertion"/><FRBRauthor as="editor" href="#eadop"/></FRBRManifestation></identification><publication date="2015-10-15" name="DOGC" number="01" showAs="Gazeta Oficial DOGC"/><classification source="#eurovoc"><keyword dictionary="EUROVOC" eId="4274" showAs="estatut jurídic" value="estatut jurídic"/></classification><lifecycle><eventRef date="2015-10-14" eId="1449764" source="#ro1" type="generation"/></lifecycle><lifecycle><eventRef date="2020-05-01" eId="1793598" source="#amd1" type="amendment"/></lifecycle><references><passiveRef eId="1793596" href="https://portaljuridic.gencat.cat/eli/es-ct/l/2011/12/29/11/con/20200501" showAs="Derogat"/><TLCOrganization eId="autor" href=" " showAs="Departament d'Empresa i Ocupació"/><TLCOrganization eId="editor" href="/ontology/organizations/eadop" showAs="EADOP"/><TLCRole eId="autor" href="/ontology/role/author" showAs="Autor"/><TLCRole eId="editor" href="/ontology/role/editor" showAs="Editor"/></references><proprietary><eadop:Work><eadop:ComplexWork><eadop:EADOP eadop:name="uri_this">https://portaljuridic.gencat.cat/eli/es-ct/d/2015/10/06/223</eadop:EADOP><eadop:EADOP eadop:name="number">223</eadop:EADOP><eadop:EADOP eadop:name="uri_schema">/eli/{jurisdiction}/{type}/{year}/{month}/{day}/{number}/{version}/{version_date}/{language}/{format}</eadop:EADOP><eadop:EADOP eadop:name="type_document">http://www.elidata.es/mdr/authority/resource-type/1/d</eadop:EADOP><eadop:EADOP eadop:name="jurisdiction">http://www.elidata.es/mdr/authority/jurisdiction/1/es-ct</eadop:EADOP><eadop:EADOP eadop:name="responsibility_of">Departament d'Empresa i Ocupació</eadop:EADOP><eadop:EADOP eadop:name="date_document">2015-10-06</eadop:EADOP><eadop:EADOP eadop:name="date_publication">2015-10-15</eadop:EADOP><eadop:EADOP eadop:name="in_force">in force</eadop:EADOP><eadop:EADOP eadop:name="has_member">https://portaljuridic.gencat.cat/eli/es-ct/d/2015/10/06/223/dof</eadop:EADOP><eadop:EADOP eadop:name="is_about">estatut jurídic</eadop:EADOP></eadop:ComplexWork><eadop:LegalResource><eadop:EADOP eadop:name="uri_this">https://portaljuridic.gencat.cat/eli/es-ct/d/2015/10/06/223/dof</eadop:EADOP><eadop:EADOP eadop:name="number">223</eadop:EADOP><eadop:EADOP eadop:name="uri_schema">/eli/{jurisdiction}/{type}/{year}/{month}/{day}/{number}/{version}/{version_date}/{language}/{format}</eadop:EADOP><eadop:EADOP eadop:name="type_document">http://www.elidata.es/mdr/authority/resource-type/1/d</eadop:EADOP><eadop:EADOP eadop:name="jurisdiction">http://www.elidata.es/mdr/authority/jurisdiction/1/es-ct</eadop:EADOP><eadop:EADOP eadop:name="responsibility_of">Departament d'Empresa i Ocupació</eadop:EADOP><eadop:EADOP eadop:name="is_about">estatut jurídic</eadop:EADOP><eadop:EADOP eadop:name="version">http://www.elidata.es/mdr/authority/version/dof</eadop:EADOP><eadop:EADOP eadop:name="version_date">2020-05-01</eadop:EADOP><eadop:EADOP eadop:name="date_document">2015-10-06</eadop:EADOP><eadop:EADOP eadop:name="date_publication">2015-10-15</eadop:EADOP><eadop:EADOP eadop:name="in_force">in force</eadop:EADOP><eadop:EADOP eadop:name="first_date_entry_in_force">2020-05-01</eadop:EADOP><eadop:EADOP eadop:name="is_member_of">https://portaljuridic.gencat.cat/eli/es-ct/d/2015/10/06/223</eadop:EADOP><eadop:EADOP eadop:name="realizes">https://portaljuridic.gencat.cat/eli/es-ct/d/2015/10/06/223/dof</eadop:EADOP><eadop:EADOP eadop:name="is_realized_by">https://portaljuridic.gencat.cat/eli/es-ct/d/2015/10/06/223/dof/cat</eadop:EADOP><eadop:EADOP eadop:name="consolidates">https://portaljuridic.gencat.cat/eli/es-ct/d/2015/10/06/223</eadop:EADOP></eadop:LegalResource></eadop:Work><eadop:LegalExpression><eadop:EADOP eadop:name="uriThis">https://portaljuridic.gencat.cat/eli/es-ct/d/2015/10/06/223/con/20200501/cat</eadop:EADOP><eadop:EADOP eadop:name="language">http://www.elidata.es/mdr/authority/language/cat</eadop:EADOP><eadop:EADOP eadop:name="title">DECRET 223/2015, de 6 d'octubre, pel qual s'aproven els Estatuts de l'Agència per a la Competitivitat de l'Empresa.</eadop:EADOP><eadop:EADOP eadop:name="publisher_agent ">https://dogc.gencat.cat/ca/sobre-el-dogc/eadop/</eadop:EADOP><eadop:EADOP eadop:name="embodies">https://portaljuridic.gencat.cat/eli/es-ct/d/2015/10/06/223/con/20200501/cat</eadop:EADOP></eadop:LegalExpression><eadop:Manifestation><eadop:Format><eadop:EADOP eadop:name="uri_this">https://portaljuridic.gencat.cat/eli/es-ct/d/2015/10/06/223/con/20200501/cat/turtle</eadop:EADOP><eadop:EADOP eadop:name="format">http://www.iana.org/assignments/media-types/text/turtle</eadop:EADOP><eadop:EADOP eadop:name="is_embodied_by">https://portaljuridic.gencat.cat/eli/es-ct/d/2015/10/06/223/con/20200501/cat/turtle</eadop:EADOP><eadop:EADOP eadop:name="legal_value">oficial</eadop:EADOP></eadop:Format><eadop:Format><eadop:EADOP eadop:name="uri_this">https://portaljuridic.gencat.cat/eli/es-ct/d/2015/10/06/223/con/20200501/cat/rdf</eadop:EADOP><eadop:EADOP eadop:name="format">http://www.iana.org/assignments/media-types/text/rdf</eadop:EADOP><eadop:EADOP eadop:name="is_embodied_by">https://portaljuridic.gencat.cat/eli/es-ct/d/2015/10/06/223/con/20200501/cat/rdf</eadop:EADOP><eadop:EADOP eadop:name="legal_value">oficial</eadop:EADOP></eadop:Format><eadop:Format><eadop:EADOP eadop:name="uri_this">https://portaljuridic.gencat.cat/eli/es-ct/d/2015/10/06/223/con/20200501/cat/pdf</eadop:EADOP><eadop:EADOP eadop:name="format">http://www.iana.org/assignments/media-types/application/pdf</eadop:EADOP><eadop:EADOP eadop:name="is_embodied_by">https://portaljuridic.gencat.cat/eli/es-ct/d/2015/10/06/223/con/20200501/cat/pdf</eadop:EADOP><eadop:EADOP eadop:name="legal_value">oficial</eadop:EADOP></eadop:Format><eadop:Format><eadop:EADOP eadop:name="uri_this">https://portaljuridic.gencat.cat/eli/es-ct/d/2015/10/06/223/con/20200501/cat/xml</eadop:EADOP><eadop:EADOP eadop:name="format">http://www.iana.org/assignments/media-types/text/xml</eadop:EADOP><eadop:EADOP eadop:name="is_embodied_by">https://portaljuridic.gencat.cat/eli/es-ct/d/2015/10/06/223/con/20200501/cat/xml</eadop:EADOP><eadop:EADOP eadop:name="legal_value">oficial</eadop:EADOP></eadop:Format><eadop:Format><eadop:EADOP eadop:name="uri_this">https://portaljuridic.gencat.cat/eli/es-ct/d/2015/10/06/223/con/20200501/cat/html</eadop:EADOP><eadop:EADOP eadop:name="format">http://www.iana.org/assignments/media-types/text/html</eadop:EADOP><eadop:EADOP eadop:name="is_embodied_by">https://portaljuridic.gencat.cat/eli/es-ct/d/2015/10/06/223/con/20200501/cat/html</eadop:EADOP><eadop:EADOP eadop:name="legal_value">oficial</eadop:EADOP></eadop:Format><eadop:Format><eadop:EADOP eadop:name="published_in_format">https://dogc.gencat.cat/ca/</eadop:EADOP></eadop:Format></eadop:Manifestation></proprietary></meta><preface title="DECRET 223/2015, de 6 d'octubre, pel qual s'aproven els Estatuts de l'Agència per a la Competitivitat de l'Empresa."/><body><hcontainer><heading/><content period="&lt;div&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;La Llei 11/2011, del 29 de desembre, de reestructuraci&amp;oacute; del sector p&amp;uacute;blic per agilitar l&amp;rsquo;activitat administrativa (DOGC n&amp;uacute;m. 6035, de 30.12.2011), modificada per la Llei 2/2014, del 27 de gener, de mesures fiscals, administratives, financeres i del sector p&amp;uacute;blic (DOGC n&amp;uacute;m. 6551, de 30.1.2014), estableix el marc legal de l&amp;rsquo;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa, entitat de dret p&amp;uacute;blic de la Generalitat de Catalunya que actua subjecta al dret privat, amb personalitat jur&amp;iacute;dica pr&amp;ograve;pia, que s&amp;rsquo;adscriu al departament competent en mat&amp;egrave;ria d&amp;rsquo;ind&amp;uacute;stria i que t&amp;eacute; com a finalitat la promoci&amp;oacute; i el desenvolupament de l&amp;rsquo;empresa mitjan&amp;ccedil;ant el desenvolupament de les actuacions i els serveis de suport necessaris per tal d&amp;rsquo;impulsar la competitivitat del sector empresarial i la seva pres&amp;egrave;ncia i interrelaci&amp;oacute; als mercats internacionals.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;De conformitat amb l&amp;rsquo;Acord GOV/106/2013, de 16 de juliol, pel qual es modifica la marca ACC1&amp;Oacute; de l&amp;rsquo;Ag&amp;egrave;ncia de Suport a l&amp;rsquo;Empresa Catalana que passa a ser la nova ACCI&amp;Oacute; (DOGC n&amp;uacute;m. 6420, de 18.7.2013), l&amp;rsquo;Ag&amp;egrave;ncia modifica la seva marca a efectes de coneixement i imatge i, d&amp;rsquo;acord amb l&amp;rsquo;article 156 de la Llei 2/2014, del 27 de gener, esmentada, la seva denominaci&amp;oacute; passa a ser Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa.&lt;/p&gt;&#10;&lt;/div&gt;&#10;&lt;div&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;L&amp;rsquo;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa &amp;eacute;s el principal instrument executor de les pol&amp;iacute;tiques de suport a la competitivitat empresarial a Catalunya, en l&amp;rsquo;&amp;agrave;mbit de la innovaci&amp;oacute;, la transfer&amp;egrave;ncia tecnol&amp;ograve;gica, la internacionalitzaci&amp;oacute;, el foment i la captaci&amp;oacute; d&amp;rsquo;inversions i l&amp;rsquo;increment de productivitat de l&amp;rsquo;empresa.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;Per tal de garantir l&amp;rsquo;objectiu de flexibilitat en les regles de funcionament de l&amp;rsquo;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa, la regulaci&amp;oacute; d&amp;rsquo;aquests Estatuts pret&amp;eacute;n no ser exhaustiva i permetre aix&amp;iacute; que, mitjan&amp;ccedil;ant l&amp;rsquo;aprovaci&amp;oacute; posterior d&amp;rsquo;un reglament d&amp;rsquo;organitzaci&amp;oacute; i r&amp;egrave;gim intern, pugui dur a terme les seves finalitats, exercir les seves funcions i complir els seus objectius de la manera m&amp;eacute;s adequada i eficient possible.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;En virtut de l&amp;rsquo;habilitaci&amp;oacute; que inclou la disposici&amp;oacute; final tercera de la Llei 11/2011, del 29 de desembre, abans esmentada, mitjan&amp;ccedil;ant aquest Decret s&amp;rsquo;aproven els Estatuts de l&amp;rsquo;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa que substitueixen els publicats pel Decret 51/2010, de 6 d&amp;rsquo;abril, d&amp;rsquo;aprovaci&amp;oacute; dels Estatuts de l&amp;rsquo;Ag&amp;egrave;ncia de Suport a l&amp;rsquo;Empresa Catalana (DOGC n&amp;uacute;m. 5603, de 8.4.2010), i que es publiquen a l&amp;rsquo;annex.&lt;/p&gt;&#10;&lt;/div&gt;&#10;&lt;div&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;Vist el dictamen del Consell de Treball, Econ&amp;ograve;mic i Social de Catalunya;&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;A proposta del conseller d&amp;rsquo;Empresa i Ocupaci&amp;oacute;; vist el dictamen de la Comissi&amp;oacute; Jur&amp;iacute;dica Assessora, i d&amp;#39;acord amb el Govern,&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;&amp;nbsp;&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;Decreto:&lt;/p&gt;&#10;&lt;/div&gt;&#10;"/></hcontainer><hcontainer><heading>Objecte</heading><content period="&lt;div style=&quot;text-align: justify;&quot;&gt;&#10;&#9;L&amp;#39;objecte d&amp;#39;aquest Decret &amp;eacute;s aprovar els Estatuts de l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa i adequar-los al t&amp;iacute;tol III, cap&amp;iacute;tol II, articles 155 al 172, en els seus termes vigents, de la Llei 11/2011, del 29 de desembre, de reestructuraci&amp;oacute; del sector p&amp;uacute;blic per a agilitar l&amp;rsquo;activitat administrativa (DOGC n&amp;uacute;m. 6035, de 30.12.2011).&lt;/div&gt;&#10;"/></hcontainer><hcontainer><heading/><content period="&lt;div style=&quot;text-align: justify;&quot;&gt;&#10;&#9;Es deroga el Decret 51/2010, de 6 d&amp;rsquo;abril, d&amp;rsquo;aprovaci&amp;oacute; dels Estatuts de l&amp;rsquo;Ag&amp;egrave;ncia de Suport a l&amp;rsquo;Empresa Catalana (DOGC n&amp;uacute;m. 5603, de 8.4.2010).&lt;/div&gt;&#10;"/></hcontainer><hcontainer><heading>Entrada en vigor</heading><content period="Aquest Decret entra en vigor l&amp;#39;endem&amp;agrave; de la seva publicaci&amp;oacute; al DOGC."/></hcontainer><hcontainer><heading>Estatuts de l'Agència per a la Competitivitat de l’Empresa</heading><content/></hcontainer><hcontainer><heading>Disposicions generals</heading><content/></hcontainer><hcontainer><heading>Naturalesa</heading><content period="&lt;div style=&quot;text-align: justify;&quot;&gt;&#10;&#9;L&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa &amp;eacute;s una entitat de dret p&amp;uacute;blic de la Generalitat de Catalunya, sense &amp;agrave;nim de lucre, que actua subjecta al dret privat, amb personalitat jur&amp;iacute;dica pr&amp;ograve;pia, plena capacitat d&amp;#39;obrar i patrimoni propi, i que per al compliment de les seves finalitats gaudeix de plena autonomia funcional i de gesti&amp;oacute;.&lt;/div&gt;&#10;"/></hcontainer><hcontainer><heading>Adscripció</heading><content period="&lt;div style=&quot;text-align: justify;&quot;&gt;&#10;&#9;L&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa s&amp;#39;adscriu al departament competent en mat&amp;egrave;ria d&amp;#39;ind&amp;uacute;stria.&lt;/div&gt;&#10;"/></hcontainer><hcontainer><heading>Seu i àmbit d'actuació</heading><content period="&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;La seu de l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa &amp;eacute;s aquella que, dins l&amp;#39;&amp;agrave;mbit territorial de Catalunya, determini el seu Consell d&amp;rsquo;Administraci&amp;oacute;.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;La seva actuaci&amp;oacute; es desenvolupa en tot el territori de Catalunya.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;En el marc de les disposicions de l&amp;#39;Estatut d&amp;#39;Autonomia de Catalunya i de la resta de la legislaci&amp;oacute; que li sigui d&amp;#39;aplicaci&amp;oacute;, l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa pot projectar la seva actuaci&amp;oacute; fora de l&amp;#39;&amp;agrave;mbit territorial de Catalunya.&lt;/p&gt;&#10;"/></hcontainer><hcontainer><heading>Règim jurídic</heading><content period="&lt;div&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;4.1 L&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa es regeix per aquests Estatuts; per la Llei 11/2011, del 29 de desembre, de reestructuraci&amp;oacute; del sector p&amp;uacute;blic per a agilitar l&amp;rsquo;activitat administrativa (DOGC n&amp;uacute;m. 6035, de 30.12.2011), modificada per la Llei 2/2014, del 27 de gener, de mesures fiscals, administratives, financeres i del sector p&amp;uacute;blic (DOGC n&amp;uacute;m. 6551, de 30.1.2014); per les normes aplicables a les entitats de dret p&amp;uacute;blic que han d&amp;#39;ajustar la seva activitat al dret privat, vinculades o dependents de l&amp;#39;Administraci&amp;oacute; de la Generalitat de Catalunya, que correspongui en cada cas, i per la resta de normativa que li sigui d&amp;#39;aplicaci&amp;oacute;.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;4.2 L&amp;rsquo;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa sotmet la seva activitat a les relacions externes, amb car&amp;agrave;cter general, a les normes de dret civil, mercantil i laboral que li s&amp;oacute;n aplicables, llevat dels actes que impliquen l&amp;rsquo;exercici de potestats p&amp;uacute;bliques, que se sotmeten al dret p&amp;uacute;blic.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;4.3 L&amp;rsquo;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa se sotmet al dret p&amp;uacute;blic en les relacions amb el departament al qual est&amp;agrave; adscrita, en el r&amp;egrave;gim d&amp;rsquo;adopci&amp;oacute; d&amp;rsquo;acords i en l&amp;rsquo;organitzaci&amp;oacute; i el funcionament dels &amp;ograve;rgans col&amp;middot;legiats de govern als quals &amp;eacute;s aplicable la normativa general sobre &amp;ograve;rgans col&amp;middot;legiats de l&amp;rsquo;Administraci&amp;oacute; de la Generalitat. Tamb&amp;eacute; se sotmet al dret p&amp;uacute;blic en les altres mat&amp;egrave;ries que, d&amp;rsquo;acord amb la llei aplicable, hi s&amp;oacute;n subjectes.&lt;/p&gt;&#10;&lt;/div&gt;&#10;&lt;div&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;4.4 Les resolucions del Consell d&amp;rsquo;Administraci&amp;oacute; i del conseller delegat o consellera delegada de l&amp;rsquo;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa exhaureixen la via administrativa. Contra aquestes resolucions es pot interposar un recurs potestatiu de reposici&amp;oacute; o directament un recurs davant la jurisdicci&amp;oacute; contenciosa administrativa.&lt;/p&gt;&#10;&lt;/div&gt;&#10;"/></hcontainer><hcontainer><heading>Finalitats, principis d’actuació i funcions de l'Agència per a la Competitivitat de l’Empresa</heading><content/></hcontainer><hcontainer><heading>Finalitat i principis d'actuació</heading><content period="&lt;div&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;5.1 L&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa t&amp;eacute; com a finalitat la promoci&amp;oacute; i el desenvolupament de l&amp;#39;empresa per mitj&amp;agrave; de l&amp;#39;execuci&amp;oacute; de les actuacions i el desplegament dels serveis de suport necessaris per impulsar la competitivitat del sector empresarial i la seva pres&amp;egrave;ncia i interrelaci&amp;oacute; en els mercats internacionals.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;5.2 Les actuacions de l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa han de ser, en tot cas, coherents amb les funcions que preveuen l&amp;#39;article 159 de la Llei 11/2011, del 29 de desembre, i aquests Estatuts.&lt;/p&gt;&#10;&lt;/div&gt;&#10;&lt;div&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;5.3 L&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa ha de consolidar una cultura professional plenament compromesa amb la igualtat real d&amp;#39;oportunitats d&amp;#39;ambd&amp;oacute;s sexes en l&amp;#39;acc&amp;eacute;s a l&amp;#39;ocupaci&amp;oacute; i la promoci&amp;oacute; professional dels seus treballadors/ores, aix&amp;iacute; com en la relaci&amp;oacute; amb tercers dins el seu &amp;agrave;mbit d&amp;rsquo;actuaci&amp;oacute;. Aix&amp;iacute; mateix, ha d&amp;#39;incorporar la perspectiva de g&amp;egrave;nere a tots els seus &amp;agrave;mbits.&lt;/p&gt;&#10;&lt;/div&gt;&#10;"/></hcontainer><hcontainer><heading>Funcions</heading><content period="&lt;div&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;6.1 Les funcions de l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa s&amp;oacute;n:&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;a) El foment de la internacionalitzaci&amp;oacute;, la innovaci&amp;oacute; i l&amp;#39;atracci&amp;oacute; d&amp;#39;inversi&amp;oacute; empresarial productiva en tots els seus aspectes.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;b) La creaci&amp;oacute; d&amp;#39;empreses, el foment de l&amp;#39;emprenedoria i la promoci&amp;oacute; empresarial, en activitats tecnol&amp;ograve;giques i d&amp;#39;alt valor afegit.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;c) La transfer&amp;egrave;ncia de coneixement i la incorporaci&amp;oacute; al sector empresarial dels resultats de la recerca i de les noves tecnologies.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;d) L&amp;#39;impuls de la capacitat i la demanda innovadora de les empreses per mitj&amp;agrave; d&amp;#39;instruments que reforcin el capital, amb suport directe a la recerca, el desenvolupament i la innovaci&amp;oacute; (R+D+I) i amb l&amp;#39;&amp;uacute;s de la compra p&amp;uacute;blica de tecnologia innovadora (CPTI).&lt;/p&gt;&#10;&lt;/div&gt;&#10;&lt;div&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;e) L&amp;#39;impuls de la competitivitat empresarial per mitj&amp;agrave; de la incorporaci&amp;oacute; d&amp;#39;instruments de la societat de la informaci&amp;oacute; i de millores organitzatives.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;f) L&amp;#39;adaptaci&amp;oacute; de l&amp;#39;organitzaci&amp;oacute; i de la prestaci&amp;oacute; dels seus serveis a les problem&amp;agrave;tiques canviants, i la garantia d&amp;#39;una utilitzaci&amp;oacute; &amp;ograve;ptima dels mitjans disponibles.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;g) Afavorir l&amp;#39;optimaci&amp;oacute; de la gesti&amp;oacute; dels recursos humans i financers de les empreses.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;h) Rebre i donar resposta, si s&amp;rsquo;escau, a les recomanacions del Consell Catal&amp;agrave; de l&amp;rsquo;Empresa en mat&amp;egrave;ria de pol&amp;iacute;tica de transformaci&amp;oacute; industrial.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;i) Altres funcions que li encomanin les lleis.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;6.2 L&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa pot dur a terme les seves activitats mitjan&amp;ccedil;ant convenis, societats, fundacions o altres f&amp;oacute;rmules de col&amp;middot;laboraci&amp;oacute; amb les corporacions de dret p&amp;uacute;blic, les associacions, els agents socials i altres entitats p&amp;uacute;bliques o privades en els termes que estableixen la normativa reguladora de l&amp;rsquo;empresa p&amp;uacute;blica catalana i altres normes aplicables.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;6.3 L&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa pot constituir el capital de qualsevol entitat que adopti la forma de societat mercantil, o participar-hi, i tamb&amp;eacute; de qualsevol altre ens, p&amp;uacute;blic o privat, amb &amp;agrave;nim de lucre o sense, l&amp;#39;objecte social del qual estigui relacionat amb l&amp;rsquo;objecte i les finalitats de l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa&lt;/p&gt;&#10;&lt;/div&gt;&#10;&lt;div&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;6.4 Per delegaci&amp;oacute; del Govern, l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa podr&amp;agrave; exercir la representaci&amp;oacute; als consorcis, als ens o als &amp;ograve;rgans mixtos constitu&amp;iuml;ts o que es constitueixin l&amp;#39;objecte dels quals estigui relacionat amb les finalitats i les funcions de l&amp;rsquo;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa.&lt;/p&gt;&#10;&lt;/div&gt;&#10;"/></hcontainer><hcontainer><heading>Estructura orgànica</heading><content/></hcontainer><hcontainer><heading>Estructura i tipologia d'òrgans</heading><content/></hcontainer><hcontainer><heading>Estructura orgànica</heading><content period="&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;7.1 Els &amp;ograve;rgans de l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa es classifiquen en &amp;ograve;rgans de govern i &amp;ograve;rgans de gesti&amp;oacute;.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;7.2 En tot all&amp;ograve; que no preveuen aquests Estatuts, el funcionament dels &amp;ograve;rgans col&amp;middot;legiats de l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa es regula pel que estableixi el seu reglament d&amp;#39;organitzaci&amp;oacute; i r&amp;egrave;gim intern i, si no n&amp;#39;hi ha, per la normativa aplicable al funcionament dels &amp;ograve;rgans col&amp;middot;legiats.&lt;/p&gt;&#10;"/></hcontainer><hcontainer><heading>Òrgans de govern</heading><content period="&lt;p&gt;&#10;&#9;S&amp;oacute;n &amp;ograve;rgans de govern els seg&amp;uuml;ents:&lt;/p&gt;&#10;&lt;p&gt;&#10;&#9;a) El Consell d&amp;#39;Administraci&amp;oacute;.&lt;/p&gt;&#10;&lt;p&gt;&#10;&#9;b) La Presid&amp;egrave;ncia.&lt;/p&gt;&#10;"/></hcontainer><hcontainer><heading>Òrgan de gestió</heading><content period="&lt;div&gt;&#10;&#9;&lt;p&gt;&#10;&#9;&#9;L&amp;#39;&amp;ograve;rgan de gesti&amp;oacute; &amp;eacute;s el conseller delegat o consellera delegada.&lt;/p&gt;&#10;&lt;/div&gt;&#10;"/></hcontainer><hcontainer><heading>Òrgans de govern</heading><content/></hcontainer><hcontainer><heading>Naturalesa i composició del Consell d'Administració</heading><content period="&lt;div&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;10.1 Correspon al Consell d&amp;#39;Administraci&amp;oacute; la decisi&amp;oacute; i la direcci&amp;oacute; de l&amp;#39;activitat de l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;10.2 Integren el Consell d&amp;rsquo;Administraci&amp;oacute; de l&amp;rsquo;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa els membres seg&amp;uuml;ents:&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;a) El conseller o la consellera del departament competent en mat&amp;egrave;ria d&amp;rsquo;ind&amp;uacute;stria, en qualitat de president o presidenta.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;b) El secretari o la secret&amp;agrave;ria sectorial en mat&amp;egrave;ria d&amp;rsquo;ind&amp;uacute;stria i, en la seva abs&amp;egrave;ncia, el secretari o la secret&amp;agrave;ria general del departament competent en mat&amp;egrave;ria d&amp;rsquo;ind&amp;uacute;stria, en qualitat de vicepresident o vicepresidenta.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;c) El director o la directora general en mat&amp;egrave;ria d&amp;rsquo;ind&amp;uacute;stria i, en la seva abs&amp;egrave;ncia, una persona nomenada pel conseller o la consellera del departament competent en mat&amp;egrave;ria d&amp;rsquo;ind&amp;uacute;stria.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;d) El conseller delegat o la consellera delegada de l&amp;rsquo;Ag&amp;egrave;ncia.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;e) Quatre persones d&amp;rsquo;altres departaments de l&amp;rsquo;Administraci&amp;oacute; de la Generalitat amb compet&amp;egrave;ncies vinculades al suport de la competitivitat empresarial, nomenades pel conseller o la consellera competent en mat&amp;egrave;ria d&amp;rsquo;ind&amp;uacute;stria, a proposta del conseller o la consellera del departament corresponent, distribu&amp;iuml;des de la manera seg&amp;uuml;ent:&lt;/p&gt;&#10;&lt;/div&gt;&#10;&lt;div&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;Una persona a proposta del departament competent en mat&amp;egrave;ria de recerca.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;Una persona a proposta del departament competent en mat&amp;egrave;ria d&amp;rsquo;afers exteriors.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;Una persona a proposta del departament competent en mat&amp;egrave;ria d&amp;rsquo;economia i finances.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;Una persona a proposta del departament competent en mat&amp;egrave;ria agroaliment&amp;agrave;ria.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;f) Quatre persones de prestigi reconegut en els &amp;agrave;mbits d&amp;rsquo;actuaci&amp;oacute; i funcions de l&amp;rsquo;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa, nomenades pel conseller o la consellera del departament competent en mat&amp;egrave;ria d&amp;rsquo;Ind&amp;uacute;stria, en els termes de l&amp;rsquo;article 157.3 de la Llei 11/2011, del 29 de desembre.&lt;/p&gt;&#10;&lt;/div&gt;&#10;"/></hcontainer><hcontainer><heading>Funcions del Consell d'Administració</heading><content period="&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;11.1 Les funcions del Consell d&amp;rsquo;Administraci&amp;oacute; s&amp;oacute;n les seg&amp;uuml;ents:&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&amp;nbsp;&amp;nbsp;&amp;nbsp;a) Dirigir l&amp;#39;actuaci&amp;oacute; de l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa d&amp;#39;acord amb els criteris determinats pel departament competent en mat&amp;egrave;ria d&amp;#39;ind&amp;uacute;stria.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&amp;nbsp;&amp;nbsp;&amp;nbsp;b) Aprovar el pla d&amp;#39;activitat anual de l&amp;#39;Ag&amp;egrave;ncia d&amp;#39;acord amb els criteris i les directrius que determini el departament competent en mat&amp;egrave;ria d&amp;#39;ind&amp;uacute;stria, ser informat sobre el seu grau d&amp;#39;execuci&amp;oacute; i proposar-ne les accions oportunes.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&amp;nbsp;&amp;nbsp;&amp;nbsp;c) Aprovar la mem&amp;ograve;ria anual d&amp;#39;activitats de l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&amp;nbsp;&amp;nbsp;&amp;nbsp;d) Aprovar les bases de les convocat&amp;ograve;ries de subvencions i ajudes que es proposin per al desenvolupament de les funcions de l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&amp;nbsp;&amp;nbsp;&amp;nbsp;e) Aprovar la proposta de Contracte de gesti&amp;oacute; pr&amp;egrave;viament a la seva aprovaci&amp;oacute; definitiva pel Govern de la Generalitat.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&amp;nbsp;&amp;nbsp;&amp;nbsp;f) Realitzar el control i el seguiment del Contracte de gesti&amp;oacute;.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&amp;nbsp;&amp;nbsp;&amp;nbsp;g) Aprovar i/o ratificar els convenis amb les altres administracions p&amp;uacute;bliques, i tamb&amp;eacute; els contractes i els convenis de col&amp;middot;laboraci&amp;oacute; que es formalitzin per a la consecuci&amp;oacute; de les finalitats de l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&amp;nbsp;&amp;nbsp;&amp;nbsp;h) Aprovar la petici&amp;oacute; de modificaci&amp;oacute; dels Estatuts i traslladar-la al conseller o la consellera del departament competent en mat&amp;egrave;ria d&amp;rsquo;ind&amp;uacute;stria perqu&amp;egrave; impulsi la proposta.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&amp;nbsp;&amp;nbsp;&amp;nbsp;i) Informar i aprovar el reglament d&amp;#39;organitzaci&amp;oacute; i r&amp;egrave;gim intern de l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa i les seves possibles modificacions.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&amp;nbsp;&amp;nbsp;&amp;nbsp;j) Informar sobre els projectes normatius que afectin l&amp;#39;&amp;agrave;mbit d&amp;#39;actuaci&amp;oacute; de l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa i la mateixa Ag&amp;egrave;ncia.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&amp;nbsp;&amp;nbsp;&amp;nbsp;k) Elaborar i aprovar l&amp;#39;avantprojecte de pressupost de l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&amp;nbsp;&amp;nbsp;&amp;nbsp;l) Aprovar les variacions pressupost&amp;agrave;ries en el marc de l&amp;#39;article 19 d&amp;#39;aquests Estatuts i l&amp;rsquo;aplicaci&amp;oacute; de recursos i de romanents de cr&amp;egrave;dit de l&amp;rsquo;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa que resultin de la liquidaci&amp;oacute; de l&amp;rsquo;exercici pressupostari no afectats al finan&amp;ccedil;ament de l&amp;rsquo;exercici seg&amp;uuml;ent puguin aplicar-se al pressupost d&amp;rsquo;ingressos i destinar-se a finan&amp;ccedil;ar l&amp;rsquo;increment de despeses, d&amp;rsquo;acord amb el que estableixen aquests Estatuts.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&amp;nbsp;&amp;nbsp;&amp;nbsp;m) Aprovar els comptes anuals i la liquidaci&amp;oacute; final dels pressupostos de l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&amp;nbsp;&amp;nbsp;&amp;nbsp;n) Aprovar la pol&amp;iacute;tica tarif&amp;agrave;ria de l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa per a la prestaci&amp;oacute; dels seus serveis.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&amp;nbsp;&amp;nbsp;&amp;nbsp;o) Realitzar el control i el seguiment de l&amp;rsquo;execuci&amp;oacute; pressupost&amp;agrave;ria trimestralment.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&amp;nbsp;&amp;nbsp;&amp;nbsp;p) Acordar la destinaci&amp;oacute; de qualsevol altre recurs diferent del que estableix l&amp;rsquo;apartat 1.a) de l&amp;rsquo;article 18 d&amp;rsquo;aquests Estatuts, i que no aparegui inicialment en el pressupost de l&amp;rsquo;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;#39;Empresa, al finan&amp;ccedil;ament de despeses excepcionals.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&amp;nbsp;&amp;nbsp;&amp;nbsp;q) Aprovar l&amp;#39;estructura organitzativa de l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;#39;Empresa a proposta del conseller/a delegat/ada.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&amp;nbsp;&amp;nbsp;&amp;nbsp;r) Aprovar la relaci&amp;oacute; de llocs de treball a proposta del conseller/a delegat/ada.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&amp;nbsp;&amp;nbsp;&amp;nbsp;s) Aprovar el r&amp;egrave;gim retributiu del personal a proposta del conseller/a delegat/ada.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&amp;nbsp;&amp;nbsp;&amp;nbsp;t) Exercir el control de la gesti&amp;oacute; del conseller/a delegat/ada i exigir les responsabilitats que procedeixin.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&amp;nbsp;&amp;nbsp;&amp;nbsp;u) Acordar l&amp;#39;exercici d&amp;#39;accions judicials i administratives de tota mena, la interposici&amp;oacute; de recursos i, en general, la defensa dels interessos i els drets de l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa en tota mena de procediments.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&amp;nbsp;&amp;nbsp;&amp;nbsp;v) Les altres funcions que li siguin encomanades d&amp;#39;acord amb la legislaci&amp;oacute; vigent.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;11.2 El Consell d&amp;#39;Administraci&amp;oacute;, si escau, pot delegar en el conseller/a delegat/ada les funcions que preveu l&amp;#39;article 11.1 anterior, amb excepci&amp;oacute; de les incloses als apartats b), c), e), g), h), i), k), l), m), n), s) i t) i les que legalment siguin indelegables.&lt;/p&gt;&#10;"/></hcontainer><hcontainer><heading>Normes de funcionament del Consell d'Administració</heading><content period="&lt;div&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;12. El Consell d&amp;#39;Administraci&amp;oacute; es reuneix en sessi&amp;oacute; ordin&amp;agrave;ria amb una periodicitat m&amp;iacute;nima bimestral i, si escau, tamb&amp;eacute; en sessions extraordin&amp;agrave;ries. Les reunions les convoca la Presid&amp;egrave;ncia del Consell a iniciativa pr&amp;ograve;pia o a petici&amp;oacute; de la meitat m&amp;eacute;s un dels seus membres.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;12.2 El president o la presidenta pot delegar la convocat&amp;ograve;ria i la presid&amp;egrave;ncia de les sessions del Consell d&amp;#39;Administraci&amp;oacute; en el vicepresident o la vicepresidenta del mateix &amp;ograve;rgan o en el membre del Consell d&amp;rsquo;Administraci&amp;oacute; que consideri oport&amp;uacute;, els/les quals disposen igualment de vot de qualitat en cas d&amp;#39;empat.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;12.3 Les convocat&amp;ograve;ries del Consell d&amp;#39;Administraci&amp;oacute; s&amp;#39;han de cursar amb una antelaci&amp;oacute; m&amp;iacute;nima de 48 hores, i s&amp;#39;admet com a mitj&amp;agrave; de convocat&amp;ograve;ria qualsevol via telem&amp;agrave;tica. A la convocat&amp;ograve;ria s&amp;#39;hi ha d&amp;#39;adjuntar l&amp;#39;ordre del dia dels assumptes a tractar i la seva documentaci&amp;oacute;.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;12.4 Per motius d&amp;#39;urg&amp;egrave;ncia, i si tots els membres del Consell d&amp;#39;Administraci&amp;oacute; s&amp;oacute;n presents i ho acorden per unanimitat, el Consell es pot constituir sense que calgui convocat&amp;ograve;ria pr&amp;egrave;via.&lt;/p&gt;&#10;&lt;/div&gt;&#10;&lt;div&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;12.5 El Consell d&amp;#39;Administraci&amp;oacute; queda v&amp;agrave;lidament constitu&amp;iuml;t quan assisteixin a la sessi&amp;oacute; la meitat m&amp;eacute;s un dels membres, incloent-hi la presid&amp;egrave;ncia o la vicepresid&amp;egrave;ncia o la persona en qui la presid&amp;egrave;ncia delegui i la Conselleria Delegada, i sempre assistits degudament per la Secretaria.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;12.6 El Consell d&amp;rsquo;Administraci&amp;oacute; es pot reunir excepcionalment mitjan&amp;ccedil;ant videoconfer&amp;egrave;ncia, multiconfer&amp;egrave;ncia o qualsevol altre sistema que no impliqui la pres&amp;egrave;ncia f&amp;iacute;sica dels seus membres. En aquests casos &amp;eacute;s necessari garantir la identificaci&amp;oacute; dels assistents a la reuni&amp;oacute;, la continu&amp;iuml;tat en la comunicaci&amp;oacute;, la possibilitat d&amp;rsquo;intervenir en les deliberacions i l&amp;rsquo;emissi&amp;oacute; del vot. La reuni&amp;oacute; s&amp;rsquo;ha d&amp;rsquo;entendre celebrada al lloc on es trobi el/la president/a. A les reunions virtuals s&amp;rsquo;han de considerar membres assistents aquells que hagin participat en la multiconfer&amp;egrave;ncia i/o videoconfer&amp;egrave;ncia i/o qualsevol altre sistema que no impliqui la pres&amp;egrave;ncia f&amp;iacute;sica dels seus membres. La convocat&amp;ograve;ria de les reunions correspon al president/a i ha d&amp;rsquo;incloure l&amp;rsquo;ordre del dia de tots aquells assumptes que s&amp;rsquo;han de tractar en la reuni&amp;oacute;, fora dels quals no es poden prendre acords v&amp;agrave;lids.&lt;/p&gt;&#10;&lt;/div&gt;&#10;&lt;div&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;12.7 En aquells casos en els quals a criteri del president/a resulti necessari, el Consell d&amp;rsquo;Administraci&amp;oacute; podr&amp;agrave; adoptar acords sense reuni&amp;oacute; mitjan&amp;ccedil;ant l&amp;rsquo;emissi&amp;oacute; del vot per correspond&amp;egrave;ncia postal, comunicaci&amp;oacute; telem&amp;agrave;tica o qualsevol altre mitj&amp;agrave; que determini el president/a, sempre que quedin garantits els drets d&amp;rsquo;informaci&amp;oacute; i de vot, que quedi const&amp;agrave;ncia de la recepci&amp;oacute; del vot, que se&amp;rsquo;n garanteixi l&amp;rsquo;autenticitat, i que cap dels seus membres sol&amp;middot;liciti la deliberaci&amp;oacute; pr&amp;egrave;via dels acords a prendre. S&amp;rsquo;entendr&amp;agrave; que l&amp;rsquo;acord s&amp;rsquo;adopta a la seu de l&amp;rsquo;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa i en la data de recepci&amp;oacute; del darrer dels vots emesos v&amp;agrave;lidament.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;12.8 Els acords del Consell d&amp;#39;Administraci&amp;oacute; s&amp;rsquo;adopten amb el vot favorable de la majoria dels membres del Consell que assisteixin a la reuni&amp;oacute;. Els representants de l&amp;#39;Administraci&amp;oacute; de la Generalitat, en cas que siguin menys en nombre en relaci&amp;oacute; amb la resta de membres, disposen del mateix nombre de vots que la resta de representants del Consell d&amp;#39;Administraci&amp;oacute; presents en el moment de la votaci&amp;oacute;. En cas d&amp;#39;empat, el president o la presidenta t&amp;eacute; vot de qualitat.&lt;/p&gt;&#10;&lt;/div&gt;&#10;&lt;div&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;12.9 El president o la presidenta podr&amp;agrave; convidar a assistir a les sessions del Consell, amb veu i sense vot, aquelles persones que jutgi convenient per les seves caracter&amp;iacute;stiques o per les aportacions que puguin fer.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;12.10 Els membres del Consell d&amp;#39;Administraci&amp;oacute; poden percebre dietes, d&amp;#39;acord amb el que estableixin el reglament d&amp;#39;organitzaci&amp;oacute; i r&amp;egrave;gim intern i la normativa aplicable.&lt;/p&gt;&#10;&lt;/div&gt;&#10;"/></hcontainer><hcontainer><heading>La Presidència</heading><content period="&lt;div&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;13.1 La Presid&amp;egrave;ncia de l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa, que n&amp;rsquo;&amp;eacute;s tamb&amp;eacute; la del Consell d&amp;#39;Administraci&amp;oacute;, correspon al conseller o la consellera competent en mat&amp;egrave;ria d&amp;#39;ind&amp;uacute;stria.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;13.2 La Presid&amp;egrave;ncia exerceix les funcions que li corresponen d&amp;#39;acord amb la normativa reguladora d&amp;#39;&amp;ograve;rgans col&amp;middot;legiats i, en particular, les seg&amp;uuml;ents:&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;a) Exercir la m&amp;eacute;s alta representaci&amp;oacute; de l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;b) Convocar les sessions del Consell d&amp;#39;Administraci&amp;oacute; i fixar-ne l&amp;rsquo;ordre del dia.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;c) Presidir i dirigir els debats del Consell d&amp;#39;Administraci&amp;oacute;.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;d) Disposar, si s&amp;#39;escau, de vot de qualitat en la presa de decisions del Consell d&amp;#39;Administraci&amp;oacute;.&lt;/p&gt;&#10;&lt;/div&gt;&#10;&lt;div&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;e) Informar el Govern i el Parlament de les actuacions de l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa quan li sigui requerit.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;13.3 El president o la presidenta pot delegar l&amp;#39;exercici de les seves funcions en el vicepresident o la vicepresidenta.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;13.4 En cas d&amp;#39;abs&amp;egrave;ncia, vacant o malaltia del president o la presidenta el/la substitueix el vicepresident o la vicepresidenta.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;13.5 La Vicepresid&amp;egrave;ncia de l&amp;rsquo;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa, que n&amp;rsquo;&amp;eacute;s tamb&amp;eacute; la del Consell d&amp;rsquo;Administraci&amp;oacute;, correspon al secretari/&amp;agrave;ria sectorial en mat&amp;egrave;ria d&amp;rsquo;ind&amp;uacute;stria i, si no n&amp;rsquo;hi ha, al secretari/&amp;agrave;ria general del departament competent en mat&amp;egrave;ria d&amp;rsquo;ind&amp;uacute;stria.&lt;/p&gt;&#10;&lt;/div&gt;&#10;"/></hcontainer><hcontainer><heading>La Secretaria dels òrgans de govern</heading><content period="&lt;div&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;14.1 Les funcions de secretari o secret&amp;agrave;ria dels &amp;ograve;rgans de govern de l&amp;rsquo;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa les exerceix una persona que presti serveis a l&amp;rsquo;Ag&amp;egrave;ncia, nomenada per la Presid&amp;egrave;ncia de l&amp;rsquo;Ag&amp;egrave;ncia i que assisteix a les reunions amb veu per&amp;ograve; sense vot.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;14.2 En cas d&amp;#39;abs&amp;egrave;ncia, malaltia o de qualsevol altra causa justificada, substitueix el secretari o secret&amp;agrave;ria la persona que designi la Presid&amp;egrave;ncia de l&amp;rsquo;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa.&lt;/p&gt;&#10;&lt;/div&gt;&#10;&lt;div&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;14.3 Les funcions de la Secretaria s&amp;oacute;n:&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;a) Trametre, per ordre del president o presidenta, les convocat&amp;ograve;ries de les reunions del Consell&amp;nbsp;d&amp;#39;Administraci&amp;oacute;.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;b) Assistir a les reunions del Consell&amp;nbsp;d&amp;#39;Administraci&amp;oacute;, amb veu per&amp;ograve; sense vot, i estendre&amp;rsquo;n les actes corresponents.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;c) Expedir els certificats relatius als acords adoptats pel Consell.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;d) Custodiar la documentaci&amp;oacute; del Consell d&amp;rsquo;Administraci&amp;oacute;.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;e) Qualsevol altra que li encomani la Presid&amp;egrave;ncia o&amp;nbsp;el conseller/a delegat/ada o de l&amp;rsquo;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa.&lt;/p&gt;&#10;&lt;/div&gt;&#10;"/></hcontainer><hcontainer><heading>Òrgan de gestió</heading><content/></hcontainer><hcontainer><heading>La Conselleria Delegada</heading><content period="&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;15.1 La Conselleria Delegada s&amp;rsquo;encarrega de la direcci&amp;oacute; general de l&amp;rsquo;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa i la nomena i la separa el Govern a proposta de la Presid&amp;egrave;ncia. El c&amp;agrave;rrec ha de recaure en una persona amb qualificacions professionals acreditades que tingui compet&amp;egrave;ncia i experi&amp;egrave;ncia per complir les funcions assignades.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;15.2 La conselleria delegada exerceix, en particular, les funcions seg&amp;uuml;ents:&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;a) Executar els acords del Consell d&amp;#39;Administraci&amp;oacute;.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;b) Preparar els estats d&amp;rsquo;execuci&amp;oacute; pressupost&amp;agrave;ria amb una periodicitat m&amp;iacute;nima trimestral.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;c) Proposar a la Presid&amp;egrave;ncia del Consell d&amp;#39;Administraci&amp;oacute; la llista d&amp;#39;assumptes de l&amp;#39;ordre del dia d&amp;#39;aquest &amp;ograve;rgan.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;d) Exercir les funcions de cap de personal i d&amp;#39;&amp;ograve;rgan de contractaci&amp;oacute; de l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;e) Autoritzar les despeses i concedir les subvencions i els ajuts, d&amp;#39;acord amb els l&amp;iacute;mits que fixi el Consell d&amp;#39;Administraci&amp;oacute;.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;f) Signar la convocat&amp;ograve;ria p&amp;uacute;blica de subvencions i ajuts aprovats pel Consell d&amp;#39;Administraci&amp;oacute; d&amp;#39;acord amb l&amp;#39;article 11.1.d) i ordenar-ne la publicaci&amp;oacute; al DOGC.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;g) Donar compte de la seva gesti&amp;oacute; al Consell d&amp;#39;Administraci&amp;oacute;.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;h) Assumir la representaci&amp;oacute; legal ordin&amp;agrave;ria de l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa, tant judicial com extrajudicial.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;i) Elaborar la relaci&amp;oacute; dels llocs de treball i la proposta d&amp;rsquo;estructura organitzativa.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;j) Aquelles que li pugui delegar el Consell d&amp;#39;Administraci&amp;oacute;.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&lt;em&gt;15.3 La Conselleria Delegada, si escau, pot delegar les funcions previstes a l&amp;#39;article 15.2 d&amp;rsquo;aquests Estatuts, amb excepci&amp;oacute; de les incloses als apartats a), c), d), g) i j) i les que legalment siguin indelegables.&lt;/em&gt;&lt;/p&gt;&#10;"/></hcontainer><hcontainer><heading>Organització administrativa de l'Agència per a la Competitivitat de l’Empresa   </heading><content/></hcontainer><hcontainer><heading>Estructura organitzativa</heading><content period="&lt;div style=&quot;text-align: justify;&quot;&gt;&#10;&#9;Sota la direcci&amp;oacute; de la Conselleria Delegada, l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa s&amp;#39;estructura d&amp;rsquo;acord amb les previsions del seu reglament d&amp;rsquo;organitzaci&amp;oacute; i r&amp;egrave;gim intern.&lt;/div&gt;&#10;"/></hcontainer><hcontainer><heading>El Contracte de gestió i el Pla d'activitat anual</heading><content/></hcontainer><hcontainer><heading>Contracte de gestió</heading><content period="&lt;div&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;17.1 El Contracte de gesti&amp;oacute;, mitjan&amp;ccedil;ant el qual s&amp;#39;articulen les relacions de l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa i el departament de l&amp;#39;Administraci&amp;oacute; de la Generalitat al qual s&amp;#39;adscriu, tindr&amp;agrave; una durada m&amp;agrave;xima de quatre anys, sens perjudici que les parts puguin promoure&amp;#39;n la modificaci&amp;oacute; o resoluci&amp;oacute;.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;17.2 El Contracte de gesti&amp;oacute; s&amp;rsquo;ha de sotmetre a la legislaci&amp;oacute; sobre finances p&amp;uacute;bliques de Catalunya i ha d&amp;#39;establir, com a m&amp;iacute;nim i per al per&amp;iacute;ode de vig&amp;egrave;ncia, els elements seg&amp;uuml;ents:&lt;/p&gt;&#10;&lt;/div&gt;&#10;&lt;div&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;a) Les activitats, els objectius i els resultats a assolir per l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;b) La planificaci&amp;oacute; dels recursos econ&amp;ograve;mics i personals per assolir els objectius.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;c) Els instruments de control i seguiment del grau d&amp;rsquo;assoliment dels objectius.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;d) Les contrapartides de recursos addicionals a obtenir en funci&amp;oacute; del grau de desenvolupament i assoliment del programa previst.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;e) Els mecanismes de modificaci&amp;oacute;, si s&amp;rsquo;escau.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;17.3 El Pla d&amp;#39;activitat anual de l&amp;rsquo;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa ha d&amp;#39;incloure necess&amp;agrave;riament les previsions del Contracte de gesti&amp;oacute;.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;17.4 El departament competent en mat&amp;egrave;ria d&amp;#39;ind&amp;uacute;stria ha d&amp;#39;elaborar i trametre el Contracte de gesti&amp;oacute;, abans que l&amp;rsquo;aprovi el Govern de la Generalitat, al Consell d&amp;rsquo;Administraci&amp;oacute; de l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa, als efectes del que estableix l&amp;#39;article 11.1.e) d&amp;#39;aquests Estatuts.&lt;/p&gt;&#10;&lt;/div&gt;&#10;"/></hcontainer><hcontainer><heading>Règim econòmic, pressupostari, de comptabilitat i de control</heading><content/></hcontainer><hcontainer><heading>Recursos econòmics</heading><content period="&lt;div&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;18.1 L&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa disposa dels recursos econ&amp;ograve;mics seg&amp;uuml;ents:&lt;/p&gt;&#10;&lt;/div&gt;&#10;&lt;div&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;a) Les assignacions amb c&amp;agrave;rrec als pressupostos de la Generalitat de Catalunya, incloses les derivades del Contracte de gesti&amp;oacute;.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;b) Els ingressos propis que percebi com a contraprestaci&amp;oacute; per les activitats que dugui a terme en virtut de contractes o convenis establerts amb altres entitats p&amp;uacute;bliques o privades o amb persones f&amp;iacute;siques o en virtut de disposicions legals.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;c) Els rendiments procedents de les tarifes aplicades per serveis prestats directament, que tenen la consideraci&amp;oacute; de preus privats.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;d) Les quantitats obtingudes per l&amp;#39;alienaci&amp;oacute; d&amp;#39;actius fixos i pel rendiment dels b&amp;eacute;ns i els valors del seu patrimoni.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;e) Els procedents dels cr&amp;egrave;dits, els pr&amp;eacute;stecs i altres operacions financeres que estableixi la Llei de pressupostos de la Generalitat de Catalunya.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;f) Les subvencions, les donacions i qualsevol altra aportaci&amp;oacute; volunt&amp;agrave;ria d&amp;#39;entitats p&amp;uacute;bliques i privades.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;g) Els d&amp;#39;ingressos de dret p&amp;uacute;blic o privat que s&amp;#39;autoritzin.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;h) Els ingressos que li siguin atribu&amp;iuml;ts i siguin compatibles amb la naturalesa i les finalitats de l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa.&lt;/p&gt;&#10;&lt;/div&gt;&#10;&lt;div&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;18.2 Els recursos de l&amp;rsquo;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa tenen car&amp;agrave;cter finalista, at&amp;egrave;s que es destinen a la consecuci&amp;oacute; dels objectius de l&amp;rsquo;Ag&amp;egrave;ncia.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;18.3 El Consell d&amp;rsquo;Administraci&amp;oacute; pot acordar destinar qualsevol altre recurs diferent dels que estableix l&amp;rsquo;apartat 18.1.a) i que no aparegui inicialment en el pressupost de l&amp;rsquo;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa per finan&amp;ccedil;ar despeses excepcionals.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;18.4 L&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa pot subscriure, en els termes i les condicions que estableix la normativa aplicable a l&amp;#39;Administraci&amp;oacute; de la Generalitat, convenis de col&amp;middot;laboraci&amp;oacute; amb entitats p&amp;uacute;bliques pertanyents a altres administracions en els &amp;agrave;mbits d&amp;#39;actuaci&amp;oacute; que, directament o indirectament, li s&amp;oacute;n propis. Aix&amp;iacute; mateix, pot subscriure convenis amb entitats privades que tinguin un inter&amp;egrave;s espec&amp;iacute;fic en la realitzaci&amp;oacute; d&amp;rsquo;accions vinculades a l&amp;#39;&amp;agrave;mbit d&amp;#39;actuaci&amp;oacute; de l&amp;#39;Ag&amp;egrave;ncia.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;18.5 L&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa pot rec&amp;oacute;rrer a l&amp;#39;endeutament d&amp;#39;acord amb la normativa de la Generalitat. No obstant el que estableixen la legislaci&amp;oacute; general i les lleis de pressupostos, l&amp;#39;Ag&amp;egrave;ncia, per a atendre desfasaments temporals de tresoreria, pot contractar p&amp;ograve;lisses de cr&amp;egrave;dit o pr&amp;eacute;stec, sempre que el saldo viu no superi el 10% del seu pressupost.&lt;/p&gt;&#10;&lt;/div&gt;&#10;"/></hcontainer><hcontainer><heading>Pressupost</heading><content period="&lt;div&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;19.1 El Consell d&amp;rsquo;Administraci&amp;oacute; ha d&amp;rsquo;elaborar i aprovar anualment l&amp;rsquo;avantprojecte de pressupost de l&amp;rsquo;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;19.2 L&amp;rsquo;avantprojecte de pressupost de l&amp;rsquo;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa, un cop aprovat, s&amp;rsquo;ha de trametre al departament al qual estigui adscrita l&amp;rsquo;Ag&amp;egrave;ncia perqu&amp;egrave; aquest el traslladi al departament competent en mat&amp;egrave;ria d&amp;rsquo;economia i finances. Un cop aprovat per aquest &amp;uacute;ltim departament, l&amp;rsquo;avantprojecte s&amp;rsquo;ha d&amp;rsquo;incorporar al projecte de llei de pressupostos de la Generalitat perqu&amp;egrave; el Govern l&amp;rsquo;aprovi i el trameti al Parlament.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;19.3 El pressupost de despeses de l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa t&amp;eacute; car&amp;agrave;cter limitador per al seu import global, i car&amp;agrave;cter estimatiu per a la distribuci&amp;oacute; dels cr&amp;egrave;dits en categories econ&amp;ograve;miques.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;19.4 L&amp;rsquo;autoritzaci&amp;oacute; de les variacions pressupost&amp;agrave;ries de l&amp;rsquo;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa correspon al departament competent en mat&amp;egrave;ria d&amp;rsquo;economia i finances en el cas de les variacions de l&amp;rsquo;import global del pressupost i de les variacions que afecten despeses de personal, a proposta del Consell d&amp;rsquo;Administraci&amp;oacute;.&lt;/p&gt;&#10;&lt;/div&gt;&#10;&lt;div&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;L&amp;rsquo;autoritzaci&amp;oacute; de les altres variacions pressupost&amp;agrave;ries correspon al Consell d&amp;rsquo;Administraci&amp;oacute;.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;Tot aix&amp;ograve;, sens perjudici de la resta de disposicions legals que siguin d&amp;rsquo;aplicaci&amp;oacute; a l&amp;rsquo;autoritzaci&amp;oacute; de les variacions pressupost&amp;agrave;ries.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;19.5 Els romanents de cr&amp;egrave;dit de l&amp;rsquo;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa que resultin de la liquidaci&amp;oacute; de l&amp;rsquo;exercici pressupostari no afectats al finan&amp;ccedil;ament de l&amp;rsquo;exercici seg&amp;uuml;ent es poden aplicar al pressupost d&amp;rsquo;ingressos i destinar-se a finan&amp;ccedil;ar l&amp;rsquo;increment de despeses per acord del Consell d&amp;rsquo;Administraci&amp;oacute;.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;19.6 L&amp;rsquo;execuci&amp;oacute; del pressupost de l&amp;rsquo;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa correspon al Consell d&amp;rsquo;Administraci&amp;oacute; i al conseller delegat o consellera delegada.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;El conseller delegat o consellera delegada ha de preparar l&amp;rsquo;estat d&amp;rsquo;execuci&amp;oacute; pressupost&amp;agrave;ria amb una periodicitat trimestral, amb l&amp;rsquo;aprovaci&amp;oacute; del Consell d&amp;rsquo;Administraci&amp;oacute;.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;19.7 En la resta de q&amp;uuml;estions, el pressupost de l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa es regeix per la normativa vigent en mat&amp;egrave;ria pressupost&amp;agrave;ria i de finances de la Generalitat de Catalunya&lt;/p&gt;&#10;&lt;/div&gt;&#10;"/></hcontainer><hcontainer><heading>Comptabilitat</heading><content period="&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;20.1 L&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa est&amp;agrave; sotmesa al r&amp;egrave;gim de comptabilitat p&amp;uacute;blica que preveu la legislaci&amp;oacute; de finances p&amp;uacute;bliques de la Generalitat de Catalunya, excepte pel que fa als aspectes que regula en els seus termes vigents la Llei 11/2011, del 29 de desembre, de reestructuraci&amp;oacute; del sector p&amp;uacute;blic per a agilitar l&amp;rsquo;activitat administrativa.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;20.2 L&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa ha d&amp;#39;ordenar la seva comptabilitat d&amp;#39;acord amb el Pla general comptable.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;20.3 L&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa ha de disposar d&amp;rsquo;un sistema d&amp;rsquo;informaci&amp;oacute; econ&amp;ograve;mica que reflecteixi, per mitj&amp;agrave; d&amp;rsquo;estats de comptes i informes, la situaci&amp;oacute; financera i l&amp;rsquo;estat, el resultat i l&amp;rsquo;execuci&amp;oacute; del seu patrimoni, i tamb&amp;eacute; la informaci&amp;oacute; de costos sobre la seva activitat. Aquesta informaci&amp;oacute; ha de ser suficient per a una adopci&amp;oacute; de decisions correcta i eficient.&lt;/p&gt;&#10;"/></hcontainer><hcontainer><heading>Control de la gestió econòmica i financera</heading><content period="&lt;div&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;21.2 El control extern de la gesti&amp;oacute; econ&amp;ograve;mica i financera de l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa correspon a la Sindicatura de Comptes i al Tribunal de Comptes d&amp;#39;acord amb la seva normativa espec&amp;iacute;fica.&lt;/p&gt;&#10;&lt;/div&gt;&#10;&lt;div&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;21.2 El control intern de la gesti&amp;oacute; econ&amp;ograve;mica i financera de l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa correspon a la Intervenci&amp;oacute; General de la Generalitat de Catalunya i es fa pel sistema d&amp;#39;auditories d&amp;#39;acord amb el que disposa el Text ref&amp;oacute;s de la Llei de finances p&amp;uacute;bliques de Catalunya.&lt;/p&gt;&#10;&lt;/div&gt;&#10;"/></hcontainer><hcontainer><heading>Règim de contractació i patrimoni</heading><content/></hcontainer><hcontainer><heading>Contractació</heading><content period="&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;22.1 El r&amp;egrave;gim de contractaci&amp;oacute; de l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa &amp;eacute;s el que estableix la normativa vigent aplicable de contractes del sector p&amp;uacute;blic per als organismes assimilats a les entitats p&amp;uacute;bliques empresarials.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;22.2 L&amp;#39;&amp;ograve;rgan de contractaci&amp;oacute; de l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa &amp;eacute;s el conseller delegat o consellera delegada.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;22.3 Les societats mercantils, les fundacions, els consorcis i qualsevol altre ens p&amp;uacute;blic o privat, amb &amp;agrave;nim de lucre o sense, creats o participats majorit&amp;agrave;riament per l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa han d&amp;#39;ajustar la seva activitat contractual al r&amp;egrave;gim que estableixi la legislaci&amp;oacute; sobre contractaci&amp;oacute; del sector p&amp;uacute;blic.&lt;/p&gt;&#10;"/></hcontainer><hcontainer><heading>Patrimoni</heading><content period="&lt;div&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;23.1 Constitueixen el patrimoni de l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa els b&amp;eacute;ns i els drets que li adscrigui l&amp;#39;Administraci&amp;oacute; de la Generalitat de Catalunya i els b&amp;eacute;ns i els drets propis, de qualsevol naturalesa, que adquireixi per qualsevol t&amp;iacute;tol, d&amp;#39;acord amb la Llei 11/2011, del 29 de desembre, i amb aquests Estatuts.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;23.2 L&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa ha d&amp;#39;establir la comptabilitat i els registres que permetin con&amp;egrave;ixer la naturalesa, la titularitat i la destinaci&amp;oacute; dels seus b&amp;eacute;ns i drets, propis o adscrits, sens perjudici de les compet&amp;egrave;ncies dels altres ens i organismes en mat&amp;egrave;ria d&amp;rsquo;ind&amp;uacute;stria i de serveis destinats a la producci&amp;oacute;.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;23.3 Els b&amp;eacute;ns i els drets que l&amp;#39;Administraci&amp;oacute; de la Generalitat adscrigui a l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa s&amp;#39;han de reincorporar al patrimoni de l&amp;#39;Administraci&amp;oacute; de la Generalitat en les mateixes condicions que tenien en el moment de produir-se l&amp;#39;adscripci&amp;oacute;, en el cas que l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa s&amp;#39;extingeixi o modifiqui les seves funcions i sempre que aquesta modificaci&amp;oacute; tingui incid&amp;egrave;ncia en els b&amp;eacute;ns i els drets esmentats. Els b&amp;eacute;ns i els drets adscrits per l&amp;#39;Administraci&amp;oacute; de la Generalitat a l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa tamb&amp;eacute; es reincorporen al patrimoni de l&amp;#39;Administraci&amp;oacute; de la Generalitat si no es dediquen al compliment de les finalitats establertes. En aquest cas, la Generalitat els ha de taxar per obtenir-ne el valor pericial i ha d&amp;rsquo;exigir el rescabalament dels detriments avaluats.&lt;/p&gt;&#10;&lt;/div&gt;&#10;&lt;div&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;23.4 La gesti&amp;oacute; del patrimoni de l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa s&amp;#39;ha d&amp;#39;ajustar, amb les excepcions que estableixen aquests Estatuts i la Llei 11/2011, del 29 de desembre, al que disposen la normativa de l&amp;rsquo;empresa p&amp;uacute;blica catalana i la normativa en mat&amp;egrave;ria de patrimoni.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;23.5 Els b&amp;eacute;ns adscrits a l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa que siguin b&amp;eacute;ns de domini p&amp;uacute;blic gaudeixen de les exempcions tribut&amp;agrave;ries que corresponen als b&amp;eacute;ns d&amp;#39;aquesta naturalesa. Els b&amp;eacute;ns adquirits d&amp;#39;una altra manera s&amp;#39;han d&amp;#39;incorporar al patrimoni de l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa.&lt;/p&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;23.6 L&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa pot adquirir b&amp;eacute;ns immobles per complir les seves finalitats, amb l&amp;rsquo;autoritzaci&amp;oacute; pr&amp;egrave;via del departament competent en mat&amp;egrave;ria de patrimoni de la Generalitat. Aix&amp;iacute; mateix, en el cas que els b&amp;eacute;ns immobles propis de l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa deixin de ser necessaris per al compliment de les seves finalitats, podran ser alienats per la mateixa Ag&amp;egrave;ncia, amb l&amp;rsquo;autoritzaci&amp;oacute; pr&amp;egrave;via del departament competent en mat&amp;egrave;ria de patrimoni de la Generalitat.&lt;/p&gt;&#10;&lt;/div&gt;&#10;"/></hcontainer><hcontainer><heading>Personal de l’Agència</heading><content period="&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;24.1 El personal de l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa s&amp;rsquo;hi vincula per mitj&amp;agrave; d&amp;rsquo;una relaci&amp;oacute; de car&amp;agrave;cter laboral.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;24.2 El personal laboral es regeix per l&amp;#39;Estatut dels treballadors, pel seu Conveni col&amp;middot;lectiu i per la resta de la normativa laboral que li sigui d&amp;#39;aplicaci&amp;oacute;.&lt;/p&gt;&#10;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;24.3 La selecci&amp;oacute; del personal de l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa s&amp;#39;ha de realitzar d&amp;#39;acord amb els principis d&amp;#39;igualtat, m&amp;egrave;rit, capacitat i publicitat, d&amp;rsquo;acord amb el que preveu la legislaci&amp;oacute; aplicable en aquesta mat&amp;egrave;ria. S&amp;#39;han de tenir en compte els criteris de paritat entre sexes i, aix&amp;iacute; mateix, les reserves de percentatges previstes en la normativa vigent per a persones amb discapacitats.&lt;/p&gt;&#10;"/></hcontainer><hcontainer><heading>Règim de personal</heading><content/></hcontainer><hcontainer><heading>Serveis Jurídics</heading><content period="&lt;div&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;L&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa est&amp;agrave; dotada de Serveis Jur&amp;iacute;dics propis, els quals han de portar a terme l&amp;#39;assessorament jur&amp;iacute;dic d&amp;#39;aquest organisme i vetllar per la legalitat de tots els seus actes, d&amp;#39;acord amb la normativa que regula els Serveis Jur&amp;iacute;dics de l&amp;#39;Administraci&amp;oacute; de la Generalitat de Catalunya, i tenen garantida l&amp;rsquo;autonomia de criteri.&lt;/p&gt;&#10;&lt;/div&gt;&#10;&lt;div&gt;&#10;&#9;&lt;p style=&quot;text-align: justify;&quot;&gt;&#10;&#9;&#9;En la seva actuaci&amp;oacute;, els Serveis Jur&amp;iacute;dics de l&amp;rsquo;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa hauran d&amp;rsquo;actuar coordinadament amb l&amp;rsquo;assessoria jur&amp;iacute;dica del departament d&amp;rsquo;adscripci&amp;oacute; en els termes que estableix l&amp;rsquo;article 15 del Decret 57/2002, de 19 febrer, de modificaci&amp;oacute; del Decret 257/1997, de 30 de setembre, pel qual s&amp;rsquo;aprova el Reglament dels serveis jur&amp;iacute;dics de l&amp;rsquo;Administraci&amp;oacute; de la Generalitat de Catalunya (DOGC n&amp;uacute;m. 3584, de 27.02.2002).&lt;/p&gt;&#10;&lt;/div&gt;&#10;"/></hcontainer><hcontainer><heading>Modificació dels Estatuts de l'Agència per a la Competitivitat de l’Empresa</heading><content/></hcontainer><hcontainer><heading>Modificació dels Estatuts</heading><content period="&lt;div style=&quot;text-align: justify;&quot;&gt;&#10;&#9;Correspon al Govern de la Generalitat de Catalunya acordar la modificaci&amp;oacute; dels Estatuts de l&amp;#39;Ag&amp;egrave;ncia per a la Competitivitat de l&amp;rsquo;Empresa, a proposta del conseller o consellera del departament competent en mat&amp;egrave;ria d&amp;#39;ind&amp;uacute;stria.&lt;/div&gt;&#10;"/></hcontainer></body></act></akomaNtoso>