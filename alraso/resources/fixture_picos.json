   "rule_id": "alraso:es-as/pn-picos/pernocta#vivac-cota-1800",
   "activity": "VIVAC_AL_RASO",
   "spatial_scope_id": "ss-pnpe-es-as",
   "effect": "PERMITTED",
   "condition": {
    "all": [
     {
      "field": "actividad_montana_o_escalada",
      "op": "is_true"
     },
     {
      "field": "nights",
      "op": "lte",
      "value": 3
     },
     {
      "field": "cota_m",
      "op": "gt",
      "value": 1800
